<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tugas Maintenance</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: var(--body-bg) !important; color: var(--body-text) !important; font-family: 'Inter', sans-serif; margin: 0; }
        .input-custom { background: var(--body-bg3, #1e1e2e) !important; border: 1.5px solid var(--body-border) !important; border-radius: 10px; color: var(--body-text) !important; padding: 10px 13px; width: 100%; margin-bottom: 0.65rem; font-size: 0.875rem; }
        .input-custom:focus { outline: none; border-color: #f97316 !important; box-shadow: 0 0 0 3px rgba(249,115,22,0.13) !important; }
        .label-text { color: var(--body-text2); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; margin-bottom: 5px; display: block; }
        .icon-text { display:inline-flex; align-items:center; gap:5px; }
        .icon-text .lc { width:13px; height:13px; }
        /* STAT CARDS */
        .stat-cards { display: grid; grid-template-columns: repeat(4,1fr); gap: 10px; margin-bottom: 14px; }
        .stat-card { background: var(--body-card); border: 1px solid var(--body-border); border-radius: 10px; padding: 14px 16px; }
        .stat-card-label { font-size: 0.68rem; font-weight: 700; text-transform: uppercase; color: var(--body-text2); margin-bottom: 4px; }
        .stat-card-value { font-size: 1.7rem; font-weight: 800; line-height: 1; }
        .stat-card.orange { border-color: #7c3300; } .stat-card.orange .stat-card-value { color: #fb923c; }
        .stat-card.green  { border-color: #1a5c1a; } .stat-card.green .stat-card-value  { color: #4caf50; }
        .stat-card.blue   { border-color: #0d3d6e; } .stat-card.blue .stat-card-value   { color: #4da6ff; }
        .stat-card.red    { border-color: #5c1a1a; } .stat-card.red .stat-card-value    { color: #ff6b6b; }
        @media(max-width:768px){ .stat-cards { grid-template-columns: repeat(2,1fr); } }
        /* TUGAS CARDS */
        .tugas-card { background: var(--body-card); border: 1px solid var(--body-border); border-radius: 12px; padding: 14px 16px; margin-bottom: 10px; transition: border-color 0.15s; }
        .tugas-card.urgent { border-left: 4px solid #ef4444; }
        .tugas-card.normal { border-left: 4px solid #f97316; }
        .tugas-card.selesai { border-left: 4px solid #22c55e; opacity: 0.7; }
        .tugas-judul { font-size: 0.95rem; font-weight: 700; color: var(--body-text); margin-bottom: 4px; }
        .tugas-desc { font-size: 0.8rem; color: var(--body-text2); margin-bottom: 8px; }
        .tugas-meta { font-size: 0.68rem; color: var(--body-text3); display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
        .tugas-info { display:grid; gap:7px; margin:9px 0 10px; }
        .tugas-info-row { display:flex; align-items:flex-start; gap:9px; padding:9px 11px; border:1px solid var(--body-border); border-radius:8px; background:var(--body-bg2); }
        .tugas-info-row .lc { width:15px; height:15px; margin-top:2px; color:var(--body-text2); flex-shrink:0; }
        .tugas-info-label { color:var(--body-text3); font-size:0.61rem; font-weight:800; letter-spacing:0.06em; line-height:1.2; margin-bottom:3px; text-transform:uppercase; }
        .tugas-info-value { color:var(--body-text); font-size:0.78rem; font-weight:600; line-height:1.45; white-space:pre-line; }
        .tugas-info-row.pelapor { border-left:3px solid #64748b; }
        .tugas-info-row.hasil { border-left:3px solid #22c55e; background:color-mix(in srgb, var(--body-card) 88%, #22c55e 12%); }
        .tugas-info-row.hasil .lc, .tugas-info-row.hasil .tugas-info-label { color:#16a34a; }
        .badge-status { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 0.65rem; font-weight: 700; }
        .badge-belum   { background: #2a1a0d; color: #fb923c; border: 1px solid #7c3300; }
        .badge-proses  { background: #0d1a38; color: #4da6ff; border: 1px solid #0d3d6e; }
        .badge-selesai { background: #0d2a18; color: #4ade80; border: 1px solid #1a5c30; }
        .badge-urgent  { background: #3d0000; color: #ff6b6b; border: 1px solid #7c0000; }
        .badge-normal  { background: #1a1a0d; color: #fde68a; border: 1px solid #5c4a00; }
        .status-line { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:10px; }
        .work-timer { display:inline-flex; align-items:center; gap:5px; min-height:24px; padding:3px 9px; border:1px solid var(--body-border2); border-radius:6px; background:var(--body-bg2); color:var(--body-text2); font-size:.67rem; font-weight:700; font-variant-numeric:tabular-nums; }
        .work-timer.running { color:#2563eb; border-color:rgba(37,99,235,.25); background:rgba(37,99,235,.06); }
        .work-timer .lc { width:12px; height:12px; }
        /* DRAWER */
        .drawer-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 1040; opacity: 0; pointer-events: none; transition: opacity 0.25s; backdrop-filter: blur(2px); }
        .drawer-overlay.open { opacity: 1; pointer-events: all; }
        .drawer-panel { position: fixed; top: 0; right: 0; bottom: 0; width: 390px; max-width: 96vw; background: var(--body-card); border-left: 1px solid var(--body-border); z-index: 1041; transform: translateX(100%); transition: transform 0.28s cubic-bezier(0.4,0,0.2,1); display: flex; flex-direction: column; overflow: hidden; }
        .drawer-panel.open { transform: translateX(0); }
        .drawer-header { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid var(--body-border); background: linear-gradient(135deg, rgba(249,115,22,0.08), transparent); }
        .drawer-title { font-size: 0.9rem; font-weight: 800; color: var(--body-text); display: flex; align-items: center; gap: 9px; }
        .drawer-close { background: var(--body-bg3); border: 1px solid var(--body-border); color: var(--body-text2); cursor: pointer; padding: 6px; border-radius: 8px; display: flex; }
        .drawer-close:hover { background: rgba(239,68,68,0.12); color: #f87171; }
        .drawer-body { flex: 1; overflow-y: auto; padding: 18px 20px 24px; }
        .field-group { background: rgba(255,255,255,0.02); border: 1px solid var(--body-border); border-radius: 12px; padding: 14px 14px 6px; margin-bottom: 10px; }
        .field-group-title { font-size: 0.6rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--body-text2); margin-bottom: 10px; display: flex; align-items: center; gap: 6px; }
        .field-group-title::before { content: ''; width: 3px; height: 12px; background: #f97316; border-radius: 2px; }
        .btn-simpan { width: 100%; padding: 13px; background: linear-gradient(135deg,#c2410c,#f97316); color: #fff; border: none; border-radius: 12px; font-size: 0.85rem; font-weight: 800; cursor: pointer; margin-top: 14px; box-shadow: 0 4px 18px rgba(249,115,22,0.3); }
        .btn-simpan:hover { opacity: 0.9; }
        .upload-area { border: 1.5px dashed var(--body-border); border-radius: 10px; padding: 12px 14px; margin-bottom: 0.65rem; cursor: pointer; position: relative; overflow: hidden; }
        .upload-area:hover { border-color: #f97316; }
        .upload-area input[type=file] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
        .upload-area-inner { display: flex; align-items: center; gap: 10px; font-size: 0.8rem; color: var(--body-text2); pointer-events: none; }
        .prioritas-toggle { display: flex; gap: 8px; margin-bottom: 0.75rem; }
        .prio-btn { flex: 1; padding: 10px 8px; border-radius: 10px; border: 1.5px solid var(--body-border); background: var(--body-bg3); color: var(--body-text2); font-size: 0.72rem; font-weight: 700; cursor: pointer; text-align: center; transition: all 0.2s; }
        .prio-btn.active-normal { background: linear-gradient(135deg,#1a1a0d,#3d3a00); border-color: #f59e0b; color: #fbbf24; }
        .prio-btn.active-urgent { background: linear-gradient(135deg,#3d0000,#7c0000); border-color: #ef4444; color: #fca5a5; }
        /* STATUS UPDATE MODAL */
        .m-content { background: var(--body-card) !important; border: 1px solid var(--body-border) !important; }
        .m-header  { border-bottom: 1px solid var(--body-border) !important; }
        .m-footer  { border-top:    1px solid var(--body-border) !important; }
        .status-btns { display: flex; gap: 8px; margin-bottom: 0.75rem; }
        .status-btn { flex: 1; padding: 10px; border-radius: 10px; border: 1.5px solid var(--body-border); background: var(--body-bg3); color: var(--body-text2); font-size: 0.75rem; font-weight: 700; cursor: pointer; text-align: center; transition: all 0.18s; }
        .status-btn.active-proses  { background: linear-gradient(135deg,#0d1a38,#1a2d5c); border-color: #4da6ff; color: #7eb8f7; }
        .status-btn.active-selesai { background: linear-gradient(135deg,#0d2a18,#1a5c30); border-color: #22c55e; color: #4ade80; }
        .fab-tugas { position: fixed; bottom: 88px; right: 24px; z-index: 1039; background: linear-gradient(135deg,#c2410c,#f97316); color: #fff; border: none; border-radius: 50px; padding: 13px 22px; font-size: 0.85rem; font-weight: 700; cursor: pointer; box-shadow: 0 4px 20px rgba(249,115,22,0.4); display: flex; align-items: center; gap: 8px; }
        .fab-tugas:hover { transform: translateY(-2px); }
        .toast-notif { position:fixed; right:20px; bottom:20px; z-index:9999; pointer-events:none; display:none; width:min(340px,calc(100vw - 28px)); }
        .toast-notif.show { display:block; animation:toastIn .22s ease-out; }
        .toast-notif-box { background:var(--body-card); border:1px solid var(--body-border2); border-left:3px solid #2563eb; border-radius:10px; padding:13px 15px; display:flex; align-items:flex-start; gap:11px; box-shadow:0 12px 30px rgba(15,23,42,.16); }
        .toast-notif-icon { width:30px; height:30px; border-radius:50%; background:rgba(37,99,235,.1); color:#2563eb; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
        .toast-notif-icon .lc { width:16px; height:16px; }
        .toast-notif-title { color:var(--body-text); font-weight:700; font-size:.82rem; line-height:1.3; }
        .toast-notif-msg { color:var(--body-text2); font-size:.72rem; margin-top:2px; line-height:1.4; }
        @keyframes toastIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
        @media(min-width:768px){
            .drawer-overlay { display: flex; align-items: center; justify-content: center; }
            .drawer-overlay.open { opacity: 1; pointer-events: all; }
            .drawer-panel {
                position: fixed;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%) scale(0.95);
                right: auto;
                bottom: auto;
                width: 520px;
                max-width: 90vw;
                max-height: 88vh;
                border-left: none;
                border: 1px solid var(--body-border);
                border-radius: 16px;
                box-shadow: 0 24px 80px rgba(0,0,0,0.5);
                opacity: 0;
                pointer-events: none;
                transition: transform 0.22s cubic-bezier(0.4,0,0.2,1), opacity 0.22s ease;
                display: flex;
                flex-direction: column;
            }
            .drawer-panel.open {
                transform: translate(-50%, -50%) scale(1);
                opacity: 1;
                pointer-events: all;
            }
        }
    </style>
</head>
<body>
<%- include('navbar', {activePage: 'tugas'}) %>

<!-- DRAWER TAMBAH TUGAS -->
<% if (canCreate) { %>
<div class="drawer-overlay" id="drawerOverlay" onclick="closeDrawer()"></div>
<div class="drawer-panel" id="drawerPanel" onclick="event.stopPropagation()">
  <div class="drawer-header">
    <div class="drawer-title">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Buat Tugas Baru
    </div>
    <button class="drawer-close" onclick="closeDrawer()">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div class="drawer-body">
    <form action="/tugas/buat" method="POST" enctype="multipart/form-data" id="formBuat">
      <input type="hidden" name="prioritas" id="prioritasVal" value="Normal">
      <div class="field-group">
        <div class="field-group-title">Detail Tugas</div>
        <span class="label-text">Judul Tugas</span>
        <input type="text" name="judul" class="input-custom" placeholder="cth: Cek mesin produksi lantai 2" required>
        <span class="label-text">Deskripsi</span>
        <textarea name="deskripsi" class="input-custom" rows="3" placeholder="Detail pekerjaan yang harus dilakukan..."></textarea>
        <span class="label-text">Tanggal</span>
        <input type="date" name="tanggal" id="tglBuat" class="input-custom" required>
      </div>
      <div class="field-group">
        <div class="field-group-title">Prioritas</div>
        <div class="prioritas-toggle">
          <div class="prio-btn active-normal icon-text" id="btnNormal" onclick="setPrioritas('Normal')"><svg class="lc" viewBox="0 0 24 24"><path d="m13 2-9 12h8l-1 8 9-12h-8z"/></svg> NORMAL</div>
          <div class="prio-btn icon-text" id="btnUrgent" onclick="setPrioritas('Urgent')"><svg class="lc" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><line x1="12" y1="7" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg> URGENT</div>
        </div>
      </div>
      <div class="field-group">
        <div class="field-group-title">Foto Petunjuk Lokasi <span style="color:#ef4444;font-size:0.7rem;font-weight:800;">* WAJIB</span></div>
        <div class="upload-area" id="uploadAreaFotoTugas" style="border-color:#f97316;">
          <input type="file" name="foto" accept="image/*" required onchange="document.getElementById('lblFotoTugas').textContent=this.files[0]?.name||'Pilih foto'; document.getElementById('uploadAreaFotoTugas').style.borderColor=this.files[0]?'#22c55e':'#ef4444';">
          <div class="upload-area-inner">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            <div><span id="lblFotoTugas">Foto lokasi/kondisi untuk petunjuk</span><small style="color:#ef4444;">Wajib diisi — pilih dari galeri atau kamera</small></div>
          </div>
        </div>
      </div>
      <button type="submit" class="btn-simpan">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
        BUAT TUGAS
      </button>
    </form>
  </div>
</div>
<button class="fab-tugas" onclick="openDrawer()">
  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
  Buat Tugas
</button>
<% } %>

<div class="container-fluid p-4">

  <% if (saved) { %>
  <div class="alert" style="background:#0d2a18;border:1px solid #1a5c30;color:#4ade80;border-radius:8px;padding:10px 14px;margin-bottom:1rem;font-weight:600;">
    <span class="icon-text"><svg class="lc" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Tugas berhasil dibuat!</span>
  </div>
  <% } %>

  <!-- PAGE HEADER -->
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:8px;">
    <div>
      <h5 style="margin:0;font-weight:700;color:var(--body-text);font-size:1.05rem;">
        <span class="icon-text"><svg class="lc" viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="13" y2="16"/></svg> Tugas Maintenance</span>
      </h5>
      <div style="font-size:0.72rem;color:var(--body-text2);margin-top:4px;">Daftar tugas harian tim maintenance</div>
    </div>
  </div>

  <!-- STAT CARDS -->
  <div class="stat-cards">
    <div class="stat-card orange">
      <div class="stat-card-label">Total Tugas</div>
      <div class="stat-card-value"><%= stats.total %></div>
    </div>
    <div class="stat-card red">
      <div class="stat-card-label">Belum Mulai</div>
      <div class="stat-card-value"><%= stats.belum %></div>
    </div>
    <div class="stat-card blue">
      <div class="stat-card-label">Sedang Proses</div>
      <div class="stat-card-value"><%= stats.proses %></div>
    </div>
    <div class="stat-card green">
      <div class="stat-card-label">Selesai</div>
      <div class="stat-card-value"><%= stats.selesai %></div>
    </div>
  </div>

  <!-- FILTER & EXPORT -->
  <div style="background:var(--body-card);border:1px solid var(--body-border);border-radius:8px;padding:12px 16px;margin-bottom:14px;">
    <!-- Filter harian -->
    <form action="/tugas" method="GET" style="display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:8px;">
      <span style="font-size:0.7rem;font-weight:700;color:var(--body-text3);text-transform:uppercase;">FILTER:</span>
      <input type="date" name="tanggal" id="filterTanggal" value="<%= filterTanggal %>" class="form-control form-control-sm" style="width:160px;background:var(--body-input);color:var(--body-text);border-color:var(--body-input-border);">
      <select name="status" class="form-select form-select-sm" style="width:auto;background:var(--body-input);color:var(--body-text);border-color:var(--body-input-border);">
        <option value="">Semua Status</option>
        <option value="Belum"   <%= filterStatus==='Belum'   ? 'selected' : '' %>>Belum</option>
        <option value="Proses"  <%= filterStatus==='Proses'  ? 'selected' : '' %>>Proses</option>
        <option value="Selesai" <%= filterStatus==='Selesai' ? 'selected' : '' %>>Selesai</option>
      </select>
      <button type="submit" class="btn btn-sm fw-bold" style="background:#ea580c;border-color:#ea580c;color:#fff;">Cari</button>
      <button type="button" onclick="setToday()" class="btn btn-sm fw-bold" style="background:var(--body-bg3);border:1px solid var(--body-border);color:var(--body-text2);">Hari Ini</button>
    </form>
    <% if (canManage) { %>
    <!-- Export range -->
    <div style="border-top:1px solid var(--body-border);padding-top:8px;display:flex;align-items:center;flex-wrap:wrap;gap:8px;">
      <span class="icon-text" style="font-size:0.7rem;font-weight:700;color:var(--body-text3);text-transform:uppercase;"><svg class="lc" viewBox="0 0 24 24"><path d="M12 3v12"/><polyline points="7 10 12 15 17 10"/><path d="M5 21h14"/></svg> EXPORT:</span>
      <!-- Export hari ini -->
      <a href="/tugas/export?tanggal=<%= filterTanggal %>"
         class="btn btn-sm fw-bold"
         style="background:#1a3a2a;border:1px solid #22c55e;color:#4ade80;white-space:nowrap;">
        <span class="icon-text"><svg class="lc" viewBox="0 0 24 24"><path d="M12 3v12"/><polyline points="7 10 12 15 17 10"/><path d="M5 21h14"/></svg> Export Hari Ini</span>
      </a>
      <!-- Export range -->
      <form action="/tugas/export" method="GET" style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
        <div style="display:flex;align-items:center;gap:4px;">
          <span style="font-size:0.7rem;color:var(--body-text3);">Dari</span>
          <input type="date" name="dateFrom" id="exportFrom" class="form-control form-control-sm" style="width:145px;background:var(--body-input);color:var(--body-text);border-color:var(--body-input-border);">
        </div>
        <div style="display:flex;align-items:center;gap:4px;">
          <span style="font-size:0.7rem;color:var(--body-text3);">s/d</span>
          <input type="date" name="dateTo" id="exportTo" class="form-control form-control-sm" style="width:145px;background:var(--body-input);color:var(--body-text);border-color:var(--body-input-border);">
        </div>
        <button type="submit" class="btn btn-sm fw-bold icon-text" style="background:#1a3a2a;border:1px solid #22c55e;color:#4ade80;white-space:nowrap;"><svg class="lc" viewBox="0 0 24 24"><path d="M12 3v12"/><polyline points="7 10 12 15 17 10"/><path d="M5 21h14"/></svg> Export Range</button>
        <button type="button" onclick="setExportThisMonth()" class="btn btn-sm fw-bold" style="background:var(--body-bg3);border:1px solid var(--body-border);color:var(--body-text2);font-size:0.68rem;">Bulan Ini</button>
      </form>
    </div>
    <% } %>
  </div>

  <!-- LIST TUGAS -->
  <% if (tugas.length === 0) { %>
  <div style="text-align:center;padding:3rem 1rem;color:var(--body-text3);">
    <div class="empty-state-icon" style="margin-bottom:8px;"><svg class="lc" viewBox="0 0 24 24"><rect x="4" y="3" width="16" height="18" rx="2"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/></svg></div>
    <div style="font-size:0.85rem;font-weight:600;">Tidak ada tugas untuk tanggal ini</div>
    <% if (canCreate) { %>
    <div style="font-size:0.75rem;margin-top:4px;">Klik <strong>Buat Tugas</strong> untuk menambah</div>
    <% } %>
  </div>
  <% } else { %>
  <% tugas.forEach(function(t) { %>
  <%
    var tglT = new Date(t.tanggal); tglT.setHours(0,0,0,0);
    var tglH = new Date(); tglH.setHours(0,0,0,0);
    var isFuture = tglT > tglH;
    var cardClass = t.status==='Selesai' ? 'selesai' : (t.prioritas==='Urgent' ? 'urgent' : 'normal');
  %>
  <div class="tugas-card <%= cardClass %>">
    <% var canEditThis = canManage || (isReporter && currentUser && t.buatOleh === currentUser.nama && t.status === 'Belum'); %>

    <!-- Baris 1: Prioritas + Judul -->
    <div style="margin-bottom:6px;">
      <% if (t.prioritas==='Urgent') { %>
      <span class="icon-text" style="background:#3d0000;color:#ff6b6b;border:1px solid #7c0000;border-radius:4px;padding:1px 7px;font-size:0.62rem;font-weight:800;margin-right:6px;vertical-align:middle;"><svg class="lc" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><line x1="12" y1="7" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg> URGENT</span>
      <% } %>
      <span style="font-size:0.92rem;font-weight:700;color:var(--body-text);line-height:1.4;"><%= t.judul %></span>
    </div>

    <!-- Informasi utama: pelapor, detail pekerjaan, dan hasil maintenance -->
    <div class="tugas-info">
      <div class="tugas-info-row pelapor">
        <svg class="lc" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
        <div>
          <div class="tugas-info-label">Dilaporkan oleh</div>
          <div class="tugas-info-value"><%= t.buatOleh %></div>
        </div>
      </div>
      <% if (t.deskripsi) { %>
      <div class="tugas-info-row">
        <svg class="lc" viewBox="0 0 24 24"><path d="M4 4h16v16H4z"/><line x1="8" y1="9" x2="16" y2="9"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/></svg>
        <div>
          <div class="tugas-info-label">Detail pekerjaan</div>
          <div class="tugas-info-value"><%= t.deskripsi %></div>
        </div>
      </div>
      <% } %>
      <% if (t.catatan) { %>
      <div class="tugas-info-row hasil">
        <svg class="lc" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><polyline points="8 12 11 15 16 9"/></svg>
        <div>
          <div class="tugas-info-label">Hasil maintenance</div>
          <div class="tugas-info-value"><%= t.catatan %></div>
        </div>
      </div>
      <% } %>
    </div>

    <!-- Baris 3: Meta -->
    <div style="font-size:0.7rem;color:var(--body-text3);margin-bottom:8px;display:flex;flex-wrap:wrap;gap:6px 12px;">
      <span class="icon-text"><svg class="lc" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><line x1="8" y1="3" x2="8" y2="7"/><line x1="16" y1="3" x2="16" y2="7"/><line x1="3" y1="10" x2="21" y2="10"/></svg><%= new Date(t.tanggal).toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'}) %></span>
      <% if (isFuture) { %><span class="icon-text" style="color:#818cf8;"><svg class="lc" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 16 14"/></svg>Terjadwal</span><% } %>
    </div>

    <!-- Baris 4: Status badge -->
    <div class="status-line">
      <span class="badge-status <%= t.status==='Selesai'?'badge-selesai':(t.status==='Proses'?'badge-proses':'badge-belum') %>">
        <%= t.status==='Selesai'?'Selesai':(t.status==='Proses'?'Dikerjakan':'Belum Mulai') %>
      </span>
      <% if (t.mulaiDikerjakanAt) { %>
      <span class="work-timer <%= t.status==='Proses' ? 'running' : '' %>"
            data-start="<%= new Date(t.mulaiDikerjakanAt).toISOString() %>"
            data-end="<%= t.selesaiDikerjakanAt ? new Date(t.selesaiDikerjakanAt).toISOString() : '' %>"
            title="<%= t.dikerjakanOleh ? 'Dikerjakan oleh ' + t.dikerjakanOleh : 'Durasi pengerjaan' %>">
        <svg class="lc" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 16 14"/></svg>
        <span class="work-timer-value">Menghitung...</span>
      </span>
      <% } %>
    </div>

    <!-- Baris 5: Tombol aksi — selalu full width, auto wrap -->
    <div style="display:flex;flex-wrap:wrap;gap:6px;">

      <% if (t.fotoTugasUrl) { %>
      <button onclick="showFoto('<%= t.fotoTugasUrl %>','Foto Petunjuk')"
        style="padding:7px 14px;background:#3d1a00;color:#fb923c;border:1px solid #7c3300;border-radius:8px;font-size:0.72rem;font-weight:700;cursor:pointer;">
        <span class="icon-text"><svg class="lc" viewBox="0 0 24 24"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0z"/><circle cx="12" cy="10" r="2"/></svg> Lihat Lokasi</span>
      </button>
      <% } %>

      <% if (t.fotoUrl) { %>
      <button onclick="showFoto('<%= t.fotoUrl %>','Bukti Selesai')"
        style="padding:7px 14px;background:#0d2a18;color:#4ade80;border:1px solid #1a5c30;border-radius:8px;font-size:0.72rem;font-weight:700;cursor:pointer;">
        <span class="icon-text"><svg class="lc" viewBox="0 0 24 24"><path d="M4 7h4l2-3h4l2 3h4v13H4z"/><circle cx="12" cy="13" r="4"/></svg> Bukti</span>
      </button>
      <% } %>

      <% if (isMtc && t.status==='Belum') { %>
      <form method="POST" action="/tugas/status/<%= t.id %>" enctype="multipart/form-data" style="margin:0;">
        <input type="hidden" name="newStatus" value="Proses">
        <input type="hidden" name="tanggal" value="<%= filterTanggal %>">
        <button type="submit"
          style="padding:7px 14px;background:#0d1a38;color:#4da6ff;border:1px solid #0d3d6e;border-radius:8px;font-size:0.72rem;font-weight:700;cursor:pointer;">
          <span class="icon-text"><svg class="lc" viewBox="0 0 24 24"><polygon points="7 4 20 12 7 20 7 4"/></svg> Mulai Kerjakan</span>
        </button>
      </form>
      <% } else if (isMtc && t.status==='Proses') { %>
      <button onclick="openSelesaiModal(<%= t.id %>,`<%- (t.judul||'').replace(/`/g,'\\`') %>`)"
        style="padding:7px 14px;background:#0d2a18;color:#4ade80;border:1px solid #1a5c30;border-radius:8px;font-size:0.72rem;font-weight:700;cursor:pointer;">
        <span class="icon-text"><svg class="lc" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Tandai Selesai</span>
      </button>
      <% } else if (!isMtc && t.status!=='Selesai') { %>
      <button onclick="openStatusModal(<%= t.id %>,'<%= t.status %>',`<%- (t.judul||'').replace(/`/g,'\\`') %>`)"
        style="padding:7px 14px;background:#0d1a38;color:#4da6ff;border:1px solid #0d3d6e;border-radius:8px;font-size:0.72rem;font-weight:700;cursor:pointer;">
        <span class="icon-text"><svg class="lc" viewBox="0 0 24 24"><path d="m13 2-9 12h8l-1 8 9-12h-8z"/></svg> Update Status</span>
      </button>
      <% } %>

      <% if (canEditThis) { %>
      <button onclick="openEditModal(<%= t.id %>,`<%- (t.judul||'').replace(/`/g,'\\`') %>`,`<%- (t.deskripsi||'').replace(/`/g,'\\`') %>`, '<%= new Date(t.tanggal).toISOString().slice(0,10) %>','<%= t.prioritas %>','<%= t.status %>','<%= t.fotoTugasUrl||'' %>')"
        style="padding:7px 14px;background:#0d3d6e;color:#7eb8f7;border:1px solid #1a5a9e;border-radius:8px;font-size:0.72rem;font-weight:700;cursor:pointer;">
        <span class="icon-text"><svg class="lc" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4z"/></svg> Edit</span>
      </button>
      <% } %>
      <% if (canManage) { %>
      <form method="POST" action="/tugas/hapus/<%= t.id %>" style="margin:0;" onsubmit="return confirm('Hapus tugas ini?')">
        <input type="hidden" name="tanggal" value="<%= filterTanggal %>">
        <button type="submit"
          style="padding:7px 14px;background:#2a0d0d;color:#f87171;border:1px solid #5c1a1a;border-radius:8px;font-size:0.72rem;font-weight:700;cursor:pointer;">
          <span class="icon-text"><svg class="lc" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M8 6V4h8v2M19 6l-1 15H6L5 6"/></svg> Hapus</span>
        </button>
      </form>
      <% } %>

    </div>
  </div>
  <% }) %>
  <% } %>

</div>

<!-- MODAL FOTO BUKTI -->
<div class="modal fade" id="fotoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content m-content">
      <div class="modal-header m-header">
        <h5 class="modal-title icon-text" style="color:var(--body-text);"><svg class="lc" viewBox="0 0 24 24"><path d="M4 7h4l2-3h4l2 3h4v13H4z"/><circle cx="12" cy="13" r="4"/></svg> Bukti Foto</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-0" style="background:#000;">
        <img id="fotoImg" src="" class="img-fluid d-block mx-auto" style="max-height:75vh;object-fit:contain;">
      </div>
    </div>
  </div>
</div>

<!-- MODAL SELESAI -->
<div class="modal fade" id="statusModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content m-content">
      <div class="modal-header m-header">
        <h5 class="modal-title icon-text" style="color:var(--body-text);"><svg class="lc" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><polyline points="8 12 11 15 16 9"/></svg> Tandai Selesai</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form id="formStatus" action="" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="newStatus" value="Selesai">
        <input type="hidden" name="tanggal" value="<%= filterTanggal %>">
        <div class="modal-body">
          <div id="statusJudul" style="font-weight:700;color:var(--body-text);margin-bottom:12px;font-size:0.9rem;"></div>
          <span class="label-text">Catatan / Hasil Pekerjaan <span style="color:#ef4444;">*</span></span>
          <textarea name="catatan" id="statusCatatan" class="input-custom" rows="2" placeholder="Jelaskan apa yang sudah dikerjakan..." required></textarea>
          <span class="label-text icon-text" style="color:#fb923c;"><svg class="lc" viewBox="0 0 24 24"><path d="M4 7h4l2-3h4l2 3h4v13H4z"/><circle cx="12" cy="13" r="4"/></svg> Foto Bukti <span style="color:#ef4444;">*</span></span>
          <div class="upload-area">
            <input type="file" name="foto" id="statusFoto" accept="image/*" capture="environment" onchange="document.getElementById('fotoLabel').textContent=this.files[0]?.name||'Pilih foto bukti'" required>
            <div class="upload-area-inner">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
              <div><span id="fotoLabel">Pilih foto bukti</span><small>Tap untuk kamera</small></div>
            </div>
          </div>
        </div>
        <div class="modal-footer m-footer">
          <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">BATAL</button>
          <button type="submit" id="btnSimpanSelesai" class="btn fw-bold icon-text" style="background:#16a34a;color:#fff;"><svg class="lc" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> TANDAI SELESAI</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- MODAL EDIT TUGAS -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content m-content">
      <div class="modal-header m-header">
        <h5 class="modal-title icon-text" style="color:var(--body-text);"><svg class="lc" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4z"/></svg> Edit Tugas</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <form id="formEdit" action="" method="POST" enctype="multipart/form-data">
        <div class="modal-body">
          <span class="label-text">Judul</span>
          <input type="text" name="judul" id="edit_judul" class="input-custom" required>
          <span class="label-text">Deskripsi</span>
          <textarea name="deskripsi" id="edit_deskripsi" class="input-custom" rows="3"></textarea>
          <span class="label-text">Tanggal</span>
          <input type="date" name="tanggal" id="edit_tanggal" class="input-custom" required>
          <span class="label-text">Prioritas</span>
          <select name="prioritas" id="edit_prioritas" class="input-custom">
            <option value="Normal">Normal</option>
            <option value="Urgent">Urgent</option>
          </select>
          <% if (canManage) { %>
            <span class="label-text">Status</span>
            <select name="status" id="edit_status" class="input-custom">
              <option value="Belum">Belum</option>
              <option value="Proses">Proses</option>
              <option value="Selesai">Selesai</option>
            </select>
          <% } else { %>
            <input type="hidden" id="edit_status" value="Belum">
          <% } %>
          <span class="label-text icon-text" style="color:#fb923c;"><svg class="lc" viewBox="0 0 24 24"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0z"/><circle cx="12" cy="10" r="2"/></svg> Ganti Foto Petunjuk Lokasi (opsional)</span>
          <div id="editFotoTugasPreview" style="display:none;margin-bottom:8px;">
            <img id="editFotoTugasImg" src="" style="width:100%;max-height:120px;object-fit:cover;border-radius:8px;border:1px solid #f97316;">
          </div>
          <div class="upload-area">
            <input type="file" name="foto" accept="image/*" onchange="previewEditFotoTugas(this)">
            <div class="upload-area-inner">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
              <div><span id="editLblFotoTugas">Biarkan kosong = tidak berubah</span><small>Pilih untuk ganti</small></div>
            </div>
          </div>
        </div>
        <div class="modal-footer m-footer">
          <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">BATAL</button>
          <button type="submit" class="btn fw-bold" style="background:#ea580c;color:#fff;">SIMPAN</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- FORM HAPUS -->
<form id="formHapus" method="POST" action="" style="display:none;"></form>

<!-- TOAST NOTIF -->
<div id="toastWrap" class="toast-notif">
  <div id="toastBox" class="toast-notif-box">
    <span id="toastIcon" class="toast-notif-icon"></span>
    <div>
      <div id="toastTitle" class="toast-notif-title"></div>
      <div id="toastMsg" class="toast-notif-msg"></div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function(){ const t=localStorage.getItem('theme')||'dark'; document.documentElement.setAttribute('data-theme',t); })();

// DRAWER
function openDrawer() {
    document.getElementById('tglBuat').value = '<%= filterTanggal %>';
    document.getElementById('drawerOverlay').classList.add('open');
    document.getElementById('drawerPanel').classList.add('open');
}
function closeDrawer() {
    document.getElementById('drawerOverlay').classList.remove('open');
    document.getElementById('drawerPanel').classList.remove('open');
}

// PRIORITAS
function setPrioritas(p) {
    document.getElementById('prioritasVal').value = p;
    document.getElementById('btnNormal').className = 'prio-btn' + (p==='Normal' ? ' active-normal' : '');
    document.getElementById('btnUrgent').className = 'prio-btn' + (p==='Urgent' ? ' active-urgent' : '');
}

// MODAL SELESAI
function openSelesaiModal(id, judul) {
    document.getElementById('formStatus').action = '/tugas/status/' + id;
    document.getElementById('statusJudul').textContent = judul;
    document.getElementById('statusCatatan').value = '';
    document.getElementById('statusFoto').value = '';
    document.getElementById('fotoLabel').textContent = 'Pilih foto bukti';
    new bootstrap.Modal(document.getElementById('statusModal')).show();
}

// EDIT MODAL
function openEditModal(id, judul, deskripsi, tanggal, prioritas, status, fotoTugasUrl) {
    document.getElementById('formEdit').action = '/tugas/edit/' + id;
    document.getElementById('edit_judul').value     = judul;
    document.getElementById('edit_deskripsi').value = deskripsi;
    document.getElementById('edit_tanggal').value   = tanggal;
    document.getElementById('edit_prioritas').value = prioritas;
    document.getElementById('edit_status').value    = status;
    // Preview foto existing
    const prevEl = document.getElementById('editFotoTugasPreview');
    const imgEl  = document.getElementById('editFotoTugasImg');
    const lblEl  = document.getElementById('editLblFotoTugas');
    if (fotoTugasUrl) {
        imgEl.src = fotoTugasUrl;
        prevEl.style.display = 'block';
        lblEl.textContent = 'Ada foto — pilih untuk ganti';
    } else {
        prevEl.style.display = 'none';
        lblEl.textContent = 'Biarkan kosong = tidak berubah';
    }
    new bootstrap.Modal(document.getElementById('editModal')).show();
}

function previewEditFotoTugas(input) {
    if (input.files && input.files[0]) {
        document.getElementById('editLblFotoTugas').textContent = input.files[0].name;
        const reader = new FileReader();
        reader.onload = e => {
            document.getElementById('editFotoTugasImg').src = e.target.result;
            document.getElementById('editFotoTugasPreview').style.display = 'block';
        };
        reader.readAsDataURL(input.files[0]);
    }
}

// FOTO
function showFoto(url, title) {
    document.getElementById('fotoImg').src = url;
    document.querySelector('#fotoModal .modal-title').textContent = title || 'Foto';
    new bootstrap.Modal(document.getElementById('fotoModal')).show();
}

// FILTER TODAY
function setToday() {
    // Pakai timezone lokal browser, bukan UTC
    const now = new Date();
    const y = now.getFullYear();
    const m = String(now.getMonth() + 1).padStart(2, '0');
    const d = String(now.getDate()).padStart(2, '0');
    window.location.href = '/tugas?tanggal=' + y + '-' + m + '-' + d;
}

// EXPORT BULAN INI
function setExportThisMonth() {
    const n = new Date();
    const s = new Date(n.getFullYear(), n.getMonth(), 1).toISOString().split('T')[0];
    const e = new Date(n.getFullYear(), n.getMonth()+1, 0).toISOString().split('T')[0];
    document.getElementById('exportFrom').value = s;
    document.getElementById('exportTo').value   = e;
}

// THEME
function toggleTheme() { const c=document.documentElement.getAttribute('data-theme'); const n=c==='dark'?'light':'dark'; document.documentElement.setAttribute('data-theme',n); localStorage.setItem('theme',n); updateThemeUI(n); }
function updateThemeUI(t) { const l=document.getElementById('navThemeLabel'); const th=document.getElementById('navThumb'); if(l) l.textContent=t==='light'?'Light':'Dark'; document.documentElement.setAttribute('data-theme',t); if(th){ th.style.transform=t==='light'?'translateX(12px)':''; th.style.background=t==='light'?'#fff':''; } }
(function(){ updateThemeUI(localStorage.getItem('theme')||'dark'); })();
function toggleUserDropdown(e) { e.stopPropagation(); document.getElementById('userDropdown')?.classList.toggle('open'); }
document.addEventListener('click', function(){ document.getElementById('userDropdown')?.classList.remove('open'); });
function toggleMobileNav() { document.getElementById('mobileNav')?.classList.add('open'); document.getElementById('sidebarOverlay')?.classList.add('open'); }
function closeSidebar() { document.getElementById('mobileNav')?.classList.remove('open'); document.getElementById('sidebarOverlay')?.classList.remove('open'); }

// TOAST
function showToast(icon, title, msg, color) {
    const wrap = document.getElementById('toastWrap');
    const box  = document.getElementById('toastBox');
    const toastIcons = {
        proses: '<svg class="lc lc-lg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 16 14"/></svg>',
        selesai: '<svg class="lc lc-lg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><polyline points="8 12 11 15 16 9"/></svg>'
    };
    document.getElementById('toastIcon').innerHTML = toastIcons[icon] || toastIcons.selesai;
    document.getElementById('toastTitle').textContent = title;
    document.getElementById('toastMsg').textContent   = msg;
    const accent = color === 'blue' ? '#2563eb' : '#16a34a';
    box.style.borderLeftColor = accent;
    document.getElementById('toastIcon').style.color = accent;
    document.getElementById('toastIcon').style.background = color === 'blue' ? 'rgba(37,99,235,.1)' : 'rgba(22,163,74,.1)';
    wrap.classList.add('show');
    setTimeout(() => { wrap.classList.remove('show'); }, 3200);
}

function formatWorkDuration(ms, isDone) {
    const totalSeconds = Math.max(0, Math.floor(ms / 1000));
    const hours = Math.floor(totalSeconds / 3600);
    const minutes = Math.floor((totalSeconds % 3600) / 60);
    const seconds = totalSeconds % 60;
    if (!isDone) {
        return [hours, minutes, seconds].map(v => String(v).padStart(2, '0')).join(':');
    }
    if (hours > 0) return 'Durasi ' + hours + 'j ' + minutes + 'm';
    if (minutes > 0) return 'Durasi ' + minutes + ' menit';
    return 'Durasi < 1 menit';
}

function updateWorkTimers() {
    document.querySelectorAll('.work-timer').forEach(timer => {
        const start = Date.parse(timer.dataset.start);
        const end = timer.dataset.end ? Date.parse(timer.dataset.end) : Date.now();
        if (Number.isNaN(start) || Number.isNaN(end)) return;
        const value = timer.querySelector('.work-timer-value');
        if (value) value.textContent = formatWorkDuration(end - start, Boolean(timer.dataset.end));
    });
}
updateWorkTimers();
setInterval(updateWorkTimers, 1000);
(function(){
    const p = new URLSearchParams(window.location.search);
    const s = p.get('statusDone');
    if (s === 'Proses')  showToast('proses', 'Tugas Diproses!', 'Silakan segera dikerjakan.', 'blue');
    if (s === 'Selesai') showToast('selesai', 'Tugas Selesai!', 'Laporan berhasil disimpan.', 'green');
    if (s) { const u = new URL(window.location); u.searchParams.delete('statusDone'); window.history.replaceState({}, '', u); }
})();</script>
</body>
</html>
