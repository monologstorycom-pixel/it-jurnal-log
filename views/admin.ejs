<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content" style="border-radius:12px;">
      <div class="modal-header" style="border-bottom:1px solid #f1f5f9;"><h5 class="modal-title" style="font-size:15px;font-weight:700;">Edit Data Jurnal</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <form id="formEdit" action="" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="tipeInput" id="editTipeInputVal" value="harian">
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-12">
              <label class="f-label">Tipe Pekerjaan</label>
              <div class="tipe-row">
                <div class="tipe-opt active-harian" id="editBtnHarian" onclick="setEditTipe('harian')">Harian</div>
                <div class="tipe-opt" id="editBtnMulti" onclick="setEditTipe('multihari')">Multi-hari</div>
              </div>
            </div>
            <div class="col-md-6" id="editFormHarian">
              <label class="f-label">Tanggal</label><input type="date" name="tanggalManual" id="edit_tanggal" class="f-input mb-2" required>
              <div class="row g-2">
                <div class="col-6"><label class="f-label">Jam Mulai</label><input type="time" name="jamMulai" id="edit_jamMulai" class="f-input"></div>
                <div class="col-6"><label class="f-label">Jam Selesai</label><input type="time" name="jamSelesai" id="edit_jamSelesai" class="f-input"></div>
              </div>
              <div class="dur-preview mt-2" id="editDurasiPreview">Durasi: <strong id="editDurasiText">-</strong></div>
            </div>
            <div class="col-md-6" id="editFormMultihari" style="display:none;">
              <label class="f-label" style="color:#7c3aed;">Tanggal & Jam Mulai</label>
              <div class="row g-2 mb-2"><div class="col-7"><input type="date" name="tanggalMulaiDate" id="edit_tanggalMulai" class="f-input"></div><div class="col-5"><input type="time" name="jamMulaiMulti" id="edit_jamMulaiMulti" class="f-input"></div></div>
              <label class="f-label" style="color:#7c3aed;">Tanggal & Jam Selesai</label>
              <div class="row g-2"><div class="col-7"><input type="date" name="tanggalSelesaiDate" id="edit_tanggalSelesai" class="f-input"></div><div class="col-5"><input type="time" name="jamSelesaiMulti" id="edit_jamSelesaiMulti" class="f-input"></div></div>
              <div class="dur-preview mt-2" id="editDurasiPreviewMulti" style="background:#faf5ff;border-color:#d8b4fe;color:#7c3aed;">Durasi: <strong id="editDurasiTextMulti">-</strong></div>
            </div>
            <div class="col-md-6">
              <label class="f-label">Pelapor / User</label><input type="text" name="pemesan" id="edit_pemesan" class="f-input mb-2" required>
              <label class="f-label">Aktivitas</label><input type="text" name="aktivitas" id="edit_aktivitas" class="f-input mb-2" required>
              <label class="f-label">Divisi</label>
              <select name="divisi" id="edit_divisi" class="f-input mb-2">
                <option>IT & IC</option><option>HRGA</option><option>Accounting</option><option>Exim & Pembelian</option>
                <option>Operasional</option><option>Finance</option><option>Produksi</option><option>Bahanbaku</option><option>Admin Sales</option>
              </select>
              <label class="f-label">Status</label>
              <select name="status" id="edit_status" class="f-input">
                <option value="Solved">Solved</option><option value="Pending">Pending</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="f-label">Deskripsi</label>
              <div style="position:relative;">
                <textarea name="deskripsi" id="edit_deskripsi" class="f-input mb-2" rows="4" required></textarea>
