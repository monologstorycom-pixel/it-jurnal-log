<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
// THEME
(function(){ var t=localStorage.getItem('theme')||'dark'; document.documentElement.setAttribute('data-theme',t); })();

// DRAWER
function openDrawer(){ document.getElementById('drawerOverlay').classList.add('open'); document.getElementById('drawerPanel').classList.add('open'); document.getElementById('tanggalInput').value=new Date().toISOString().split('T')[0]; }
function closeDrawer(){ document.getElementById('drawerOverlay').classList.remove('open'); document.getElementById('drawerPanel').classList.remove('open'); }

// TIPE TOGGLE
function setTipe(t){ document.getElementById('tipeInputVal').value=t; document.getElementById('btnHarian').className='tipe-opt'+(t==='harian'?' active-harian':''); document.getElementById('btnMulti').className='tipe-opt'+(t==='multihari'?' active-multi':''); document.getElementById('formHarian').style.display=t==='harian'?'':'none'; document.getElementById('formMultihari').style.display=t==='multihari'?'':'none'; }
function setEditTipe(t){ document.getElementById('editTipeInputVal').value=t; document.getElementById('editBtnHarian').className='tipe-opt'+(t==='harian'?' active-harian':''); document.getElementById('editBtnMulti').className='tipe-opt'+(t==='multihari'?' active-multi':''); document.getElementById('editFormHarian').style.display=t==='harian'?'':'none'; document.getElementById('editFormMultihari').style.display=t==='multihari'?'':'none'; if(t==='multihari')updatePreviewMultiEdit(); else updatePreviewHarian('edit_jamMulai','edit_jamSelesai','editDurasiPreview','editDurasiText'); }

// STATUS PILL
function setStatusPill(s){ document.getElementById('statusVal').value=s; document.getElementById('pillSolved').className='status-opt'+(s==='Solved'?' active-solved':''); document.getElementById('pillPending').className='status-opt'+(s==='Pending'?' active-pending':''); }

// DURASI
function hitungMenit(a,b){ if(!a||!b)return null; var aP=a.split(':').map(Number),bP=b.split(':').map(Number),mA=aP[0]*60+aP[1],mB=bP[0]*60+bP[1]; if(mB<mA)mB+=1440; return mB-mA>0?mB-mA:null; }
function hitungMenitDT(tA,jA,tB,jB){ if(!tA||!tB)return null; var a=new Date(tA+'T'+(jA||'00:00')+':00'),b=new Date(tB+'T'+(jB||'00:00')+':00'); var d=Math.floor((b-a)/60000); return d>0?d:null; }
function formatDurasi(m){ if(!m||m<=0)return null; var h=Math.floor(m/1440),s=m%1440,j=Math.floor(s/60),mn=s%60,p=[]; if(h>0)p.push(h+' hari'); if(j>0)p.push(j+' jam'); if(mn>0)p.push(mn+' menit'); return p.length?p.join(' '):'0 menit'; }
function updatePreviewHarian(mId,sId,pId,tId){ var d=hitungMenit(document.getElementById(mId).value,document.getElementById(sId).value),el=document.getElementById(pId); if(d){document.getElementById(tId).textContent=formatDurasi(d);el.style.display='block';}else el.style.display='none'; }
function updatePreviewMulti(){ var d=hitungMenitDT(document.getElementById('tanggalMulaiDate').value,document.getElementById('jamMulaiMulti').value,document.getElementById('tanggalSelesaiDate').value,document.getElementById('jamSelesaiMulti').value),el=document.getElementById('durasiPreviewMulti'); if(d){document.getElementById('durasiTextMulti').textContent=formatDurasi(d);el.style.display='block';}else el.style.display='none'; }
function updatePreviewMultiEdit(){ var d=hitungMenitDT(document.getElementById('edit_tanggalMulai').value,document.getElementById('edit_jamMulaiMulti').value,document.getElementById('edit_tanggalSelesai').value,document.getElementById('edit_jamSelesaiMulti').value),el=document.getElementById('editDurasiPreviewMulti'); if(d){document.getElementById('editDurasiTextMulti').textContent=formatDurasi(d);el.style.display='block';}else el.style.display='none'; }
['jamMulaiInput','jamSelesaiInput'].forEach(function(id){var el=document.getElementById(id);if(el)el.addEventListener('change',function(){updatePreviewHarian('jamMulaiInput','jamSelesaiInput','durasiPreview','durasiText');});});
['tanggalMulaiDate','jamMulaiMulti','tanggalSelesaiDate','jamSelesaiMulti'].forEach(function(id){var el=document.getElementById(id);if(el)el.addEventListener('change',updatePreviewMulti);});
['edit_jamMulai','edit_jamSelesai'].forEach(function(id){var el=document.getElementById(id);if(el)el.addEventListener('change',function(){updatePreviewHarian('edit_jamMulai','edit_jamSelesai','editDurasiPreview','editDurasiText');});});
['edit_tanggalMulai','edit_jamMulaiMulti','edit_tanggalSelesai','edit_jamSelesaiMulti'].forEach(function(id){var el=document.getElementById(id);if(el)el.addEventListener('change',updatePreviewMultiEdit);});

// FILE LABEL
function updateFileLabel(input,labelId){ if(input.files&&input.files[0])document.getElementById(labelId).textContent=input.files[0].name; }

// FOTO SLIDER
var _aFUrls=[],_aFIdx=0;
function showFoto(urls,judul){ _aFUrls=Array.isArray(urls)?urls:[urls]; _aFIdx=0; _renderAdminFoto(judul); new bootstrap.Modal(document.getElementById('fotoModalAdmin')).show(); }
function _renderAdminFoto(judulOverride){ var total=_aFUrls.length; document.getElementById('popupImageAdmin').src=_aFUrls[_aFIdx]; var judul=judulOverride||_aFUrls._judul||'Foto'; if(judulOverride)_aFUrls._judul=judulOverride; document.getElementById('fotoModalTitle').textContent=judul+(total>1?' ('+(_aFIdx+1)+'/'+total+')':''); var bP=document.getElementById('adminFotoPrev'),bN=document.getElementById('adminFotoNext'); if(total>1){bP.style.display='block';bN.style.display='block';}else{bP.style.display='none';bN.style.display='none';} var dots=document.getElementById('adminFotoDots');dots.innerHTML=''; if(total>1){_aFUrls.forEach(function(u,i){var th=document.createElement('img');th.src=u;th.onclick=(function(idx){return function(){_aFIdx=idx;_renderAdminFoto();};})(i);Object.assign(th.style,{width:'48px',height:'48px',objectFit:'cover',borderRadius:'6px',cursor:'pointer',border:i===_aFIdx?'2px solid #2563eb':'2px solid transparent',opacity:i===_aFIdx?'1':'0.5',margin:'8px 0'});dots.appendChild(th);});}else{dots.style.padding='0';} }
function adminSliderNav(dir){_aFIdx=Math.max(0,Math.min(_aFUrls.length-1,_aFIdx+dir));_renderAdminFoto();}

// UPLOAD MODALS
function openUploadModal(id){ document.getElementById('formUploadSusulan').action='/upload-foto/'+id; new bootstrap.Modal(document.getElementById('uploadSusulanModal')).show(); }
function openUploadAwalModal(id){ document.getElementById('formUploadAwal').action='/upload-foto-awal/'+id; new bootstrap.Modal(document.getElementById('uploadAwalModal')).show(); }

// EDIT MODAL
function openEditModal(id,aktivitas,divisi,pemesan,deskripsi,status,tipeInput,tanggal,jamMulai,jamSelesai,tglMulai,tglSelesai){
  document.getElementById('formEdit').action='/edit/'+id;
  document.getElementById('edit_aktivitas').value=aktivitas; document.getElementById('edit_pemesan').value=pemesan;
  document.getElementById('edit_deskripsi').value=deskripsi.replace(/\\n/g,'\n'); document.getElementById('edit_status').value=status;
  var ds=document.getElementById('edit_divisi'); for(var i=0;i<ds.options.length;i++){if(ds.options[i].value===divisi){ds.selectedIndex=i;break;}}
  setEditTipe(tipeInput||'harian');
  if(tipeInput==='multihari'){document.getElementById('edit_tanggalMulai').value=tglMulai||'';document.getElementById('edit_tanggalSelesai').value=tglSelesai||'';document.getElementById('edit_jamMulaiMulti').value=jamMulai||'';document.getElementById('edit_jamSelesaiMulti').value=jamSelesai||'';}
  else{document.getElementById('edit_tanggal').value=tanggal||'';document.getElementById('edit_jamMulai').value=jamMulai||'';document.getElementById('edit_jamSelesai').value=jamSelesai||'';}
  new bootstrap.Modal(document.getElementById('editModal')).show();
}

// DELETE
function confirmDelete(id,nama){ document.getElementById('formDelete').action='/delete/'+id; document.getElementById('deleteItemName').textContent=nama; new bootstrap.Modal(document.getElementById('deleteModal')).show(); }

// FILTER QUICK
function fmt(d){return d.toISOString().split('T')[0];}
function setToday(){var t=new Date();document.getElementById('filterFrom').value=fmt(t);document.getElementById('filterTo').value=fmt(t);document.getElementById('filterForm').submit();}
function setYesterday(){var t=new Date();t.setDate(t.getDate()-1);document.getElementById('filterFrom').value=fmt(t);document.getElementById('filterTo').value=fmt(t);document.getElementById('filterForm').submit();}
function setLast7(){var e=new Date(),s=new Date();s.setDate(s.getDate()-6);document.getElementById('filterFrom').value=fmt(s);document.getElementById('filterTo').value=fmt(e);document.getElementById('filterForm').submit();}
function setThisMonth(){var n=new Date(),s=new Date(n.getFullYear(),n.getMonth(),1),e=new Date(n.getFullYear(),n.getMonth()+1,0);document.getElementById('filterFrom').value=fmt(s);document.getElementById('filterTo').value=fmt(e);document.getElementById('filterForm').submit();}

// EXPORT BTN SYNC
var ef=document.getElementById('filterFrom'),et=document.getElementById('filterTo'),eb=document.getElementById('exportBtn');
function syncExport(){if(eb)eb.href='/export?dateFrom='+(ef?ef.value:'')+'&dateTo='+(et?et.value:'');}
if(ef)ef.addEventListener('change',syncExport); if(et)et.addEventListener('change',syncExport);

// TOAST
window.addEventListener('load',function(){var el=document.getElementById('saveToast');if(el){var t=new bootstrap.Toast(el,{delay:3500});t.show();}});

// AI DESC
async function aiGenerateDesc(){ var aktivitas=document.getElementById('add_deskripsi').closest('form').querySelector('[name="aktivitas"]').value.trim(); if(!aktivitas){alert('Isi Aktivitas dulu.');return;} var btn=event.target; btn.textContent='...'; btn.disabled=true; try{ var r=await fetch('/ai/generate-desc',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({aktivitas:aktivitas,divisi:'',pemesan:''})}); var d=await r.json(); if(d.result){document.getElementById('add_deskripsi').value=d.result;} }catch(e){} btn.textContent='AI'; btn.disabled=false; }
async function aiGenerateDescEdit(){ var aktivitas=document.getElementById('edit_aktivitas').value.trim(); if(!aktivitas){alert('Isi Aktivitas dulu.');return;} var btn=event.target; btn.textContent='...'; btn.disabled=true; try{ var r=await fetch('/ai/generate-desc',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({aktivitas:aktivitas,divisi:'',pemesan:''})}); var d=await r.json(); if(d.result){document.getElementById('edit_deskripsi').value=d.result;} }catch(e){} btn.textContent='AI'; btn.disabled=false; }

// THEME TOGGLE
function toggleTheme(){var c=document.documentElement.getAttribute('data-theme');var n=c==='dark'?'light':'dark';document.documentElement.setAttribute('data-theme',n);localStorage.setItem('theme',n);updateThemeUI(n);}
function updateThemeUI(t){var l=document.getElementById('navThemeLabel');var th=document.getElementById('navThumb');if(l)l.textContent=t==='light'?'Light':'Dark';document.documentElement.setAttribute('data-theme',t);if(th){th.style.transform=t==='light'?'translateX(12px)':'';th.style.background=t==='light'?'#fff':'';}};
(function(){updateThemeUI(localStorage.getItem('theme')||'dark');})();
function toggleUserDropdown(e){e.stopPropagation();document.getElementById('userDropdown')?.classList.toggle('open');}
document.addEventListener('click',function(){document.getElementById('userDropdown')?.classList.remove('open');});
function toggleMobileNav(){document.getElementById('mobileNav')?.classList.add('open');document.getElementById('sidebarOverlay')?.classList.add('open');}
function closeSidebar(){document.getElementById('mobileNav')?.classList.remove('open');document.getElementById('sidebarOverlay')?.classList.remove('open');}
</script>
