<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#ffffff">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <title>Dashboard IT — Jurnal Log</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { background: #f1f5f9; color: #0f172a; font-family: 'Inter', system-ui, sans-serif; margin: 0; font-size: 14px; }

    /* ── LAYOUT ── */
    .page { max-width: 1400px; margin: 0 auto; padding: 24px 20px 80px; }

    /* ── STAT CARDS ── */
    .stats { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px; margin-bottom: 20px; }
    .stat { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px 20px; }
    .stat-label { font-size: 12px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 6px; }
    .stat-val { font-size: 28px; font-weight: 700; line-height: 1; }
    .stat-sub { font-size: 12px; color: #94a3b8; margin-top: 4px; }
    .stat-green .stat-val  { color: #16a34a; }
    .stat-yellow .stat-val { color: #d97706; }
    .stat-blue .stat-val   { color: #2563eb; }
    .stat-red .stat-val    { color: #dc2626; }
    @media(max-width:768px){ .stats { grid-template-columns: repeat(2,1fr); } }

    /* ── PENDING STRIP ── */
    .pending-strip { background: #fff; border: 1px solid #fca5a5; border-left: 4px solid #dc2626; border-radius: 12px; padding: 16px 20px; margin-bottom: 20px; }
    .pending-strip-title { font-size: 13px; font-weight: 700; color: #dc2626; margin-bottom: 12px; }
    .pending-item { display: flex; align-items: center; gap: 12px; padding: 10px 12px; background: #fef2f2; border-radius: 8px; margin-bottom: 8px; }
    .pending-item:last-child { margin-bottom: 0; }
    .pending-info { flex: 1; min-width: 0; }
    .pending-title { font-size: 13px; font-weight: 600; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .pending-meta  { font-size: 12px; color: #64748b; margin-top: 2px; }
    .age-badge { font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 20px; white-space: nowrap; flex-shrink: 0; }
    .age-urgent  { background: #fee2e2; color: #dc2626; }
    .age-warning { background: #fef3c7; color: #d97706; }
    .age-normal  { background: #f1f5f9; color: #64748b; }
    .pending-actions { display: flex; gap: 6px; flex-shrink: 0; }
    .btn-solve { padding: 5px 12px; border-radius: 6px; border: 1px solid #16a34a; background: #f0fdf4; color: #16a34a; font-size: 12px; font-weight: 600; cursor: pointer; }
    .btn-solve:hover { background: #16a34a; color: #fff; }
    .btn-edit-sm { padding: 5px 12px; border-radius: 6px; border: 1px solid #3b82f6; background: #eff6ff; color: #2563eb; font-size: 12px; font-weight: 600; cursor: pointer; }
    .btn-edit-sm:hover { background: #2563eb; color: #fff; }

    /* ── TOOLBAR ── */
    .toolbar { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px 18px; margin-bottom: 16px; display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
    .toolbar-label { font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: .05em; white-space: nowrap; }
    .chip { padding: 5px 12px; border-radius: 20px; border: 1px solid #e2e8f0; background: #f8fafc; color: #64748b; font-size: 12px; font-weight: 600; cursor: pointer; transition: all .12s; white-space: nowrap; }
    .chip:hover, .chip.active { background: #2563eb; border-color: #2563eb; color: #fff; }
    .form-control-sm, .form-select-sm { border: 1px solid #e2e8f0 !important; border-radius: 8px !important; font-size: 13px !important; background: #f8fafc !important; color: #0f172a !important; }
    .form-control-sm:focus, .form-select-sm:focus { border-color: #93c5fd !important; box-shadow: 0 0 0 3px rgba(59,130,246,.1) !important; }
    .btn-search { padding: 5px 16px; background: #2563eb; color: #fff; border: none; border-radius: 8px; font-size: 13px; font-weight: 600; cursor: pointer; }
    .btn-export { padding: 5px 14px; background: #f0fdf4; color: #16a34a; border: 1px solid #86efac; border-radius: 8px; font-size: 13px; font-weight: 600; text-decoration: none; white-space: nowrap; }
    .btn-reset  { padding: 5px 12px; background: #f8fafc; color: #64748b; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 13px; font-weight: 600; text-decoration: none; }
    .divider-v { width: 1px; height: 20px; background: #e2e8f0; }

    /* ── TABLE ── */
    .table-wrap { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; }
    .table-head { padding: 14px 18px; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
    .table-title { font-size: 13px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .04em; }
    .count-badge { background: #f1f5f9; color: #475569; border-radius: 20px; padding: 2px 10px; font-size: 12px; font-weight: 600; }
    .data-table { width: 100%; border-collapse: collapse; min-width: 900px; }
    .data-table thead th { padding: 10px 14px; font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: .05em; background: #f8fafc; border-bottom: 1px solid #e2e8f0; white-space: nowrap; text-align: left; }
    .data-table tbody td { padding: 12px 14px; font-size: 13px; color: #0f172a; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
    .data-table tbody tr:last-child td { border-bottom: none; }
    .data-table tbody tr:hover td { background: #fafafa; }
    .cell-date { font-size: 13px; font-weight: 600; color: #0f172a; }
    .cell-time { font-size: 12px; color: #64748b; margin-top: 2px; }
    .dur-badge { display: inline-block; background: #eff6ff; color: #2563eb; border-radius: 4px; padding: 1px 6px; font-size: 11px; font-weight: 600; margin-top: 3px; }
    .dur-badge-multi { background: #faf5ff; color: #7c3aed; }
    .multi-tag { display: inline-block; background: #faf5ff; color: #7c3aed; border-radius: 4px; padding: 1px 6px; font-size: 10px; font-weight: 700; margin-bottom: 2px; }
    .cell-title { font-weight: 600; color: #0f172a; margin-bottom: 2px; }
    .cell-desc  { font-size: 12px; color: #64748b; }
    .badge-solved  { display: inline-block; background: #f0fdf4; color: #16a34a; border: 1px solid #86efac; border-radius: 20px; padding: 2px 10px; font-size: 11px; font-weight: 700; }
    .badge-pending { display: inline-block; background: #fffbeb; color: #d97706; border: 1px solid #fcd34d; border-radius: 20px; padding: 2px 10px; font-size: 11px; font-weight: 700; }
    .btn-foto-awal   { display: block; width: 100%; padding: 4px 8px; background: #fffbeb; color: #d97706; border: 1px solid #fcd34d; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer; margin-bottom: 4px; text-align: center; }
    .btn-foto-sesudah{ display: block; width: 100%; padding: 4px 8px; background: #f8fafc; color: #475569; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer; margin-bottom: 4px; text-align: center; }
    .btn-foto-add    { display: block; width: 100%; padding: 4px 8px; background: transparent; color: #94a3b8; border: 1px dashed #cbd5e1; border-radius: 6px; font-size: 11px; cursor: pointer; margin-bottom: 4px; text-align: center; }
    .btn-row-solve { padding: 4px 10px; background: #f0fdf4; color: #16a34a; border: 1px solid #86efac; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer; display: block; width: 100%; margin-bottom: 4px; }
    .btn-row-edit  { padding: 4px 10px; background: #eff6ff; color: #2563eb; border: 1px solid #93c5fd; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer; display: block; width: 100%; margin-bottom: 4px; }
    .btn-row-del   { padding: 4px 10px; background: #fef2f2; color: #dc2626; border: 1px solid #fca5a5; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer; display: block; width: 100%; }
    .empty-state { text-align: center; padding: 48px 20px; color: #94a3b8; }
    .empty-state .icon { font-size: 36px; margin-bottom: 10px; }
    .empty-state p { font-size: 14px; font-weight: 600; margin: 0 0 4px; color: #64748b; }
    .empty-state small { font-size: 13px; }

    /* ── DRAWER / MODAL ── */
    .overlay { position: fixed; inset: 0; background: rgba(15,23,42,.4); z-index: 1040; opacity: 0; pointer-events: none; transition: opacity .2s; backdrop-filter: blur(2px); }
    .overlay.open { opacity: 1; pointer-events: all; }
    .drawer { position: fixed; top: 0; right: 0; bottom: 0; width: 400px; max-width: 96vw; background: #fff; border-left: 1px solid #e2e8f0; z-index: 1041; transform: translateX(100%); transition: transform .25s cubic-bezier(.4,0,.2,1); display: flex; flex-direction: column; box-shadow: -8px 0 40px rgba(0,0,0,.08); }
    .drawer.open { transform: translateX(0); }
    .drawer-hd { display: flex; align-items: center; justify-content: space-between; padding: 18px 20px; border-bottom: 1px solid #f1f5f9; }
    .drawer-hd-title { font-size: 15px; font-weight: 700; color: #0f172a; }
    .drawer-close { background: #f8fafc; border: 1px solid #e2e8f0; color: #64748b; border-radius: 8px; padding: 5px 10px; cursor: pointer; font-size: 16px; line-height: 1; }
    .drawer-close:hover { background: #fee2e2; color: #dc2626; border-color: #fca5a5; }
    .drawer-bd { flex: 1; overflow-y: auto; padding: 20px; }
    .drawer-bd::-webkit-scrollbar { width: 4px; }
    .drawer-bd::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 4px; }

    /* ── FORM ELEMENTS ── */
    .f-group { margin-bottom: 16px; }
    .f-label { display: block; font-size: 12px; font-weight: 600; color: #374151; margin-bottom: 5px; }
    .f-input { width: 100%; padding: 9px 12px; border: 1px solid #d1d5db; border-radius: 8px; font-size: 13px; color: #0f172a; background: #fff; outline: none; transition: border-color .15s, box-shadow .15s; }
    .f-input:focus { border-color: #93c5fd; box-shadow: 0 0 0 3px rgba(59,130,246,.1); }
    textarea.f-input { resize: vertical; min-height: 80px; }
    .f-section { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 14px; margin-bottom: 14px; }
    .f-section-title { font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 12px; }
    .tipe-row { display: flex; gap: 8px; margin-bottom: 12px; }
    .tipe-opt { flex: 1; padding: 9px 6px; border-radius: 8px; border: 1.5px solid #e2e8f0; background: #f8fafc; color: #64748b; font-size: 12px; font-weight: 600; cursor: pointer; text-align: center; transition: all .15s; }
    .tipe-opt.active-harian { background: #f0fdf4; border-color: #86efac; color: #16a34a; }
    .tipe-opt.active-multi  { background: #faf5ff; border-color: #d8b4fe; color: #7c3aed; }
    .status-row { display: flex; gap: 8px; }
    .status-opt { flex: 1; padding: 9px 6px; border-radius: 8px; border: 1.5px solid #e2e8f0; background: #f8fafc; color: #64748b; font-size: 12px; font-weight: 600; cursor: pointer; text-align: center; transition: all .15s; }
    .status-opt.active-solved  { background: #f0fdf4; border-color: #86efac; color: #16a34a; }
    .status-opt.active-pending { background: #fffbeb; border-color: #fcd34d; color: #d97706; }
    .dur-preview { background: #f0fdf4; border: 1px solid #86efac; border-radius: 8px; padding: 8px 12px; font-size: 12px; color: #16a34a; font-weight: 600; text-align: center; display: none; margin-top: 8px; }
    .file-drop { border: 1.5px dashed #d1d5db; border-radius: 8px; padding: 12px; cursor: pointer; position: relative; overflow: hidden; margin-bottom: 10px; }
    .file-drop:hover { border-color: #93c5fd; background: #f0f9ff; }
    .file-drop input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
    .file-drop-inner { display: flex; align-items: center; gap: 10px; font-size: 12px; color: #64748b; pointer-events: none; }
    .file-drop-inner .icon { font-size: 18px; }
    .btn-submit { width: 100%; padding: 11px; background: #2563eb; color: #fff; border: none; border-radius: 10px; font-size: 14px; font-weight: 700; cursor: pointer; margin-top: 4px; transition: background .15s; }
    .btn-submit:hover { background: #1d4ed8; }
    .btn-submit-green { background: #16a34a; } .btn-submit-green:hover { background: #15803d; }

    /* ── FAB ── */
    .fab { position: fixed; bottom: 28px; right: 24px; z-index: 1039; background: #2563eb; color: #fff; border: none; border-radius: 50px; padding: 12px 20px; font-size: 14px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 20px rgba(37,99,235,.35); display: flex; align-items: center; gap: 8px; }
    .fab:hover { background: #1d4ed8; transform: translateY(-1px); }

    /* ── TOAST ── */
    .toast-success { background: #f0fdf4; border: 1px solid #86efac; color: #16a34a; border-radius: 10px; padding: 12px 16px; font-size: 13px; font-weight: 600; }

    /* ── DESKTOP MODAL ── */
    @media(min-width:768px){
      .overlay.open { display: flex; align-items: center; justify-content: center; }
      .drawer { position: fixed; top: 50%; left: 50%; transform: translate(-50%,-50%) scale(.95); right: auto; bottom: auto; width: 520px; max-width: 92vw; max-height: 90vh; border-left: none; border: 1px solid #e2e8f0; border-radius: 16px; box-shadow: 0 20px 60px rgba(0,0,0,.12); opacity: 0; pointer-events: none; transition: transform .2s, opacity .2s; }
      .drawer.open { transform: translate(-50%,-50%) scale(1); opacity: 1; pointer-events: all; }
    }
    @media(max-width:768px){ .page { padding: 16px 12px 80px; } }
  </style>
</head>
<body>
<%- include('navbar', {activePage: 'dashboard'}) %>

<!-- DRAWER TAMBAH LOG -->
<div class="overlay" id="drawerOverlay" onclick="closeDrawer()"></div>
<div class="drawer" id="drawerPanel" onclick="event.stopPropagation()">
  <div class="drawer-hd">
    <span class="drawer-hd-title">+ Tambah Log Baru</span>
    <button class="drawer-close" onclick="closeDrawer()">✕</button>
  </div>
  <div class="drawer-bd">
    <form action="/save" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="tipeInput" id="tipeInputVal" value="harian">
      <input type="hidden" name="status" id="statusVal" value="Solved">

      <div class="f-section">
        <div class="f-section-title">Tipe Pekerjaan</div>
        <div class="tipe-row">
          <div class="tipe-opt active-harian" id="btnHarian" onclick="setTipe('harian')">Harian</div>
          <div class="tipe-opt" id="btnMulti" onclick="setTipe('multihari')">Multi-hari</div>
        </div>
        <div id="formHarian">
          <div class="f-group"><label class="f-label">Tanggal</label><input type="date" name="tanggalManual" id="tanggalInput" class="f-input" required></div>
          <div class="row g-2 mb-2">
            <div class="col-6"><label class="f-label">Jam Mulai</label><input type="time" name="jamMulai" id="jamMulaiInput" class="f-input"></div>
            <div class="col-6"><label class="f-label">Jam Selesai</label><input type="time" name="jamSelesai" id="jamSelesaiInput" class="f-input"></div>
          </div>
          <div class="dur-preview" id="durasiPreview">Durasi: <strong id="durasiText">-</strong></div>
        </div>
        <div id="formMultihari" style="display:none;">
          <div class="f-group"><label class="f-label" style="color:#7c3aed;">Tanggal & Jam Mulai</label>
            <div class="row g-2"><div class="col-7"><input type="date" name="tanggalMulaiDate" id="tanggalMulaiDate" class="f-input"></div><div class="col-5"><input type="time" name="jamMulaiMulti" id="jamMulaiMulti" class="f-input"></div></div>
          </div>
          <div class="f-group"><label class="f-label" style="color:#7c3aed;">Tanggal & Jam Selesai</label>
            <div class="row g-2"><div class="col-7"><input type="date" name="tanggalSelesaiDate" id="tanggalSelesaiDate" class="f-input"></div><div class="col-5"><input type="time" name="jamSelesaiMulti" id="jamSelesaiMulti" class="f-input"></div></div>
          </div>
          <div class="dur-preview" id="durasiPreviewMulti" style="background:#faf5ff;border-color:#d8b4fe;color:#7c3aed;">Durasi: <strong id="durasiTextMulti">-</strong></div>
        </div>
      </div>

      <div class="f-section">
        <div class="f-section-title">Detail Pekerjaan</div>
        <div class="f-group"><label class="f-label">Pelapor / User</label><input type="text" name="pemesan" class="f-input" placeholder="Nama user / peminta" required></div>
        <div class="f-group"><label class="f-label">Aktivitas</label><input type="text" name="aktivitas" class="f-input" placeholder="Jenis pekerjaan" required></div>
        <div class="f-group"><label class="f-label">Divisi</label>
          <select name="divisi" class="f-input">
            <option>IT & IC</option><option>HRGA</option><option>Accounting</option><option>Exim & Pembelian</option>
            <option>Operasional</option><option>Finance</option><option>Produksi</option><option>Bahanbaku</option>
            <option>MAINTENANCE</option><option>Admin Sales</option>
          </select>
        </div>
        <div class="f-group"><label class="f-label">Deskripsi</label>
          <div style="position:relative;">
            <textarea name="deskripsi" id="add_deskripsi" class="f-input" rows="3" placeholder="Detail pekerjaan..." required></textarea>
            <button type="button" onclick="aiGenerateDesc()" style="position:absolute;bottom:8px;right:8px;background:#6366f1;color:#fff;border:none;border-radius:6px;padding:3px 10px;font-size:11px;font-weight:700;cursor:pointer;">AI</button>
          </div>
        </div>
      </div>

      <div class="f-section">
        <div class="f-section-title">Status</div>
        <div class="status-row">
          <div class="status-opt active-solved" id="pillSolved" onclick="setStatusPill('Solved')">✓ Solved</div>
          <div class="status-opt" id="pillPending" onclick="setStatusPill('Pending')">⏳ Pending</div>
        </div>
      </div>

      <div class="f-section">
        <div class="f-section-title">Dokumentasi Foto</div>
        <label class="f-label" style="color:#d97706;">Foto Awal (Sebelum)</label>
        <div class="file-drop"><input type="file" name="fotoAwal" accept="image/*" capture="environment" onchange="updateFileLabel(this,'lblAwal')">
          <div class="file-drop-inner"><span class="icon">📷</span><div><span id="lblAwal">Pilih atau ambil foto</span><br><small style="opacity:.6;">JPG, PNG</small></div></div>
        </div>
        <label class="f-label" style="color:#2563eb;">Foto Sesudah (Selesai)</label>
        <div class="file-drop"><input type="file" name="foto" accept="image/*" capture="environment" onchange="updateFileLabel(this,'lblSesudah')">
          <div class="file-drop-inner"><span class="icon">📷</span><div><span id="lblSesudah">Pilih atau ambil foto</span><br><small style="opacity:.6;">JPG, PNG</small></div></div>
        </div>
      </div>

      <button type="submit" class="btn-submit btn-submit-green">Simpan Data</button>
    </form>
  </div>
</div>

<% if (typeof userPerms !== 'undefined' && userPerms.canAdd) { %>
<button class="fab" onclick="openDrawer()">+ Tambah Log</button>
<% } %>

<div class="page">

  <% if (saved) { %>
  <div class="position-fixed top-0 end-0 p-3" style="z-index:1055;">
    <div id="saveToast" class="toast toast-success align-items-center border-0" role="alert">
      <div class="d-flex"><div class="toast-body">✓ Data berhasil disimpan.</div>
        <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast"></button>
      </div>
    </div>
  </div>
  <% } %>

  <!-- STAT CARDS -->
  <div class="stats">
    <div class="stat stat-green">
      <div class="stat-label">Solved Hari Ini</div>
      <div class="stat-val"><%= stats.solvedHariIni %></div>
      <div class="stat-sub">dari <%= stats.totalHariIni %> tiket</div>
    </div>
    <div class="stat stat-yellow">
      <div class="stat-label">Pending Hari Ini</div>
      <div class="stat-val"><%= stats.pendingHariIni %></div>
      <div class="stat-sub">belum selesai</div>
    </div>
    <div class="stat stat-blue">
      <div class="stat-label">Total Log</div>
      <div class="stat-val"><%= stats.totalAllTime %></div>
      <div class="stat-sub">semua waktu</div>
    </div>
    <div class="stat stat-red">
      <div class="stat-label">Total Pending</div>
      <div class="stat-val"><%= stats.pendingAllTime %></div>
      <div class="stat-sub">semua waktu</div>
    </div>
  </div>

  <!-- PENDING STRIP -->
  <% if (stats.pendingItems.length > 0) { %>
  <div class="pending-strip">
    <div class="pending-strip-title">⚠ Tiket Pending Perlu Perhatian &nbsp;<span style="background:#dc2626;color:#fff;border-radius:20px;padding:1px 8px;font-size:11px;"><%= stats.pendingAllTime %></span></div>
    <% stats.pendingItems.forEach(function(p) { %>
    <div class="pending-item">
      <div class="pending-info">
        <div class="pending-title"><%= p.aktivitas %></div>
        <div class="pending-meta"><%= p.pemesan %> · <%= p.divisi %> · <%= new Date(p.tanggalManual).toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'}) %></div>
      </div>
      <% if (p.hariPending >= 3) { %><span class="age-badge age-urgent"><%= p.hariPending %> hari</span>
      <% } else if (p.hariPending >= 1) { %><span class="age-badge age-warning"><%= p.hariPending %> hari</span>
      <% } else { %><span class="age-badge age-normal">Baru</span><% } %>
      <div class="pending-actions">
        <form method="POST" action="/update-status/<%= p.id %>" style="margin:0;">
          <input type="hidden" name="newStatus" value="Solved">
          <button type="submit" class="btn-solve" onclick="return confirm('Tandai Solved?')">✓ Selesai</button>
        </form>
        <button class="btn-edit-sm" onclick="openEditModal(<%= p.id %>,`<%- (p.aktivitas||'').replace(/`/g,'\\`') %>`,`<%= p.divisi %>`,`<%- (p.pemesan||'').replace(/`/g,'\\`') %>`,`<%- (p.deskripsi||'').replace(/`/g,'\\`').replace(/\n/g,'\\n') %>`,`<%= p.status %>`,`<%= p.tipeInput||'harian' %>`,`<%= new Date(p.tanggalManual).toISOString().slice(0,10) %>`,`<%= p.jamMulai||'' %>`,`<%= p.jamSelesai||'' %>`,`<%= p.tanggalMulai?new Date(p.tanggalMulai).toISOString().slice(0,10):'' %>`,`<%= p.tanggalSelesai?new Date(p.tanggalSelesai).toISOString().slice(0,10):'' %>`)">Edit</button>
      </div>
    </div>
    <% }) %>
    <% if (stats.pendingAllTime > 10) { %><div style="text-align:center;font-size:12px;color:#94a3b8;margin-top:8px;">+<%= stats.pendingAllTime-10 %> tiket lainnya</div><% } %>
  </div>
  <% } %>

  <!-- TOOLBAR FILTER -->
  <div class="toolbar">
    <span class="toolbar-label">Filter:</span>
    <form action="/kerja" method="GET" id="filterForm" style="display:contents;">
      <button type="button" onclick="setToday()" class="chip <%= (!filterDateFrom&&!filterDateTo&&!filterStatus)?'active':'' %>">Hari Ini</button>
      <button type="button" onclick="setYesterday()" class="chip">Kemarin</button>
      <button type="button" onclick="setLast7()" class="chip">7 Hari</button>
      <button type="button" onclick="setThisMonth()" class="chip">Bulan Ini</button>
      <div class="divider-v"></div>
      <input type="date" name="dateFrom" id="filterFrom" value="<%= filterDateFrom %>" class="form-control form-control-sm" style="width:145px;">
      <span style="font-size:12px;color:#94a3b8;">s/d</span>
      <input type="date" name="dateTo" id="filterTo" value="<%= filterDateTo %>" class="form-control form-control-sm" style="width:145px;">
      <select name="status" class="form-select form-select-sm" style="width:auto;">
        <option value="" <%= filterStatus===''?'selected':'' %>>Semua Status</option>
        <option value="Pending" <%= filterStatus==='Pending'?'selected':'' %>>Pending</option>
        <option value="Solved"  <%= filterStatus==='Solved' ?'selected':'' %>>Solved</option>
      </select>
      <button type="submit" class="btn-search">Cari</button>
      <% if (typeof userPerms!=='undefined'&&(userPerms.canExport||userPerms.canAudit)) { %>
      <a id="exportBtn" href="/export?dateFrom=<%= filterDateFrom %>&dateTo=<%= filterDateTo %>" class="btn-export">↓ Export</a>
      <% } %>
      <% if (isFiltered) { %><a href="/kerja" class="btn-reset">✕ Reset</a><% } %>
    </form>
  </div>

  <!-- TABLE -->
  <div class="table-wrap">
    <div class="table-head">
      <div style="display:flex;align-items:center;gap:8px;">
        <span class="table-title">Log Jurnal IT</span>
        <span class="count-badge"><%= filterLabel %> · <%= journals.length %> data</span>
      </div>
    </div>
    <div style="overflow-x:auto;">
      <% if (journals.length === 0) { %>
      <div class="empty-state">
        <div class="icon">📋</div>
        <p>Tidak ada data untuk <strong><%= filterLabel %></strong></p>
        <small><a href="/kerja" style="color:#2563eb;">Reset filter</a></small>
      </div>
      <% } else { %>
      <table class="data-table">
        <thead>
          <tr>
            <th>Waktu & Durasi</th>
            <th>Unit</th>
            <th style="width:32%;">Aktivitas</th>
            <th>Status</th>
            <th>Foto</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% journals.forEach(item => { var isMulti = item.tipeInput === 'multihari'; %>
          <tr>
            <td style="min-width:140px;">
              <% if (isMulti && item.tanggalMulai && item.tanggalSelesai) { %>
                <span class="multi-tag">Multi-hari</span>
                <div class="cell-date"><%= new Date(item.tanggalMulai).toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'}) %></div>
                <div class="cell-time" style="color:#94a3b8;">↓ <%= new Date(item.tanggalSelesai).toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'}) %></div>
                <% if(item.durasiMenit) { %><span class="dur-badge dur-badge-multi"><%= formatDurasi(item.durasiMenit) %></span><% } %>
              <% } else { %>
                <div class="cell-date"><%= new Date(item.tanggalManual).toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'}) %></div>
                <% if(item.jamMulai) { %><div class="cell-time">Mulai: <%= item.jamMulai %></div><% } %>
                <% if(item.jamSelesai) { %><div class="cell-time">Selesai: <%= item.jamSelesai %></div><% } %>
                <% if(item.durasiMenit) { %><span class="dur-badge"><%= formatDurasi(item.durasiMenit) %></span><% } %>
              <% } %>
            </td>
            <td style="white-space:nowrap;">
              <div style="font-weight:600;"><%= item.divisi %></div>
              <div style="font-size:12px;color:#64748b;"><%= item.pemesan %></div>
            </td>
            <td>
              <div class="cell-title"><%= item.aktivitas %></div>
              <div class="cell-desc"><%= item.deskripsi %></div>
            </td>
            <td>
              <% if(item.status==='Solved') { %><span class="badge-solved">Solved</span>
              <% } else { %><span class="badge-pending">Pending</span><% } %>
            </td>
            <td style="min-width:110px;">
              <% if(item.fotoAwalUrl) { %><button class="btn-foto-awal" onclick="showFoto('<%= item.fotoAwalUrl %>','Foto Awal')">📷 Awal</button>
              <% } else { %><button class="btn-foto-add" onclick="openUploadAwalModal(<%= item.id %>)">+ Foto Awal</button><% } %>
              <% if(item.fotoUrl) { %><button class="btn-foto-sesudah" onclick="showFoto('<%= item.fotoUrl %>','Foto Sesudah')">📷 Sesudah</button>
              <% } else { %><button class="btn-foto-add" onclick="openUploadModal(<%= item.id %>)">+ Foto Sesudah</button><% } %>
            </td>
            <td style="min-width:100px;">
              <% if(item.status==='Pending') { %>
              <form action="/update-status/<%= item.id %>" method="POST"><input type="hidden" name="newStatus" value="Solved">
                <button type="submit" class="btn-row-solve">✓ Solved</button>
              </form><% } %>
              <button class="btn-row-edit" onclick="openEditModal(<%= item.id %>,`<%- item.aktivitas.replace(/`/g,'\\`') %>`,`<%= item.divisi %>`,`<%- item.pemesan.replace(/`/g,'\\`') %>`,`<%- item.deskripsi.replace(/`/g,'\\`').replace(/\n/g,'\\n') %>`,`<%= item.status %>`,`<%= item.tipeInput||'harian' %>`,`<%= new Date(item.tanggalManual).toISOString().slice(0,10) %>`,`<%= item.jamMulai||'' %>`,`<%= item.jamSelesai||'' %>`,`<%= item.tanggalMulai?new Date(item.tanggalMulai).toISOString().slice(0,10):'' %>`,`<%= item.tanggalSelesai?new Date(item.tanggalSelesai).toISOString().slice(0,10):'' %>`)">Edit</button>
              <button class="btn-row-del" onclick="confirmDelete(<%= item.id %>,`<%- item.aktivitas.replace(/`/g,'\\`') %>`)">Hapus</button>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>
</div>

<!-- MODAL FOTO -->
