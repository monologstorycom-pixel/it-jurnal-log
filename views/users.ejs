<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <title>Manajemen User</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    *,*::before,*::after{box-sizing:border-box;}
    body{background:#f1f5f9;color:#0f172a;font-family:'Inter',system-ui,sans-serif;margin:0;font-size:14px;}
    .page{max-width:1300px;margin:0 auto;padding:24px 20px;}
    .alert-ok{background:#f0fdf4;border:1px solid #86efac;color:#16a34a;border-radius:10px;padding:10px 16px;font-size:13px;font-weight:600;margin-bottom:16px;}
    .alert-err{background:#fef2f2;border:1px solid #fca5a5;color:#dc2626;border-radius:10px;padding:10px 16px;font-size:13px;font-weight:600;margin-bottom:16px;}

    /* FORM PANEL */
    .form-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:24px;position:sticky;top:72px;}
    .form-card-title{font-size:15px;font-weight:700;color:#0f172a;margin-bottom:20px;padding-bottom:12px;border-bottom:1px solid #f1f5f9;}
    .f-label{display:block;font-size:12px;font-weight:600;color:#374151;margin-bottom:5px;}
    .f-input{width:100%;padding:9px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:13px;color:#0f172a;background:#fff;outline:none;transition:border-color .15s,box-shadow .15s;margin-bottom:12px;}
    .f-input:focus{border-color:#93c5fd;box-shadow:0 0 0 3px rgba(59,130,246,.1);}
    .pass-bar{height:3px;border-radius:2px;background:#e2e8f0;overflow:hidden;margin-top:-8px;margin-bottom:12px;}
    .pass-fill{height:100%;border-radius:2px;transition:width .3s,background .3s;width:0%;}

    /* PRESETS */
    .preset-row{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px;}
    .preset{padding:5px 12px;border-radius:20px;font-size:12px;font-weight:700;cursor:pointer;border:1.5px solid;transition:all .12s;}
    .p-admin {background:#eff6ff;color:#2563eb;border-color:#93c5fd;} .p-admin:hover{background:#2563eb;color:#fff;}
    .p-user  {background:#f0fdf4;color:#16a34a;border-color:#86efac;} .p-user:hover{background:#16a34a;color:#fff;}
    .p-viewer{background:#f8fafc;color:#64748b;border-color:#cbd5e1;} .p-viewer:hover{background:#64748b;color:#fff;}
    .p-mtc   {background:#fff7ed;color:#d97706;border-color:#fcd34d;} .p-mtc:hover{background:#d97706;color:#fff;}
    .p-vmtc  {background:#f0f9ff;color:#0284c7;border-color:#7dd3fc;} .p-vmtc:hover{background:#0284c7;color:#fff;}
    .p-tmtc  {background:#fdf4ff;color:#9333ea;border-color:#d8b4fe;} .p-tmtc:hover{background:#9333ea;color:#fff;}
    .p-clear {background:#f8fafc;color:#94a3b8;border-color:#e2e8f0;} .p-clear:hover{background:#e2e8f0;color:#374151;}
    .profile-help{font-size:11px;color:#64748b;line-height:1.45;margin:-6px 0 12px;}
    .advanced-access{border-top:1px solid #e2e8f0;margin-top:12px;padding-top:10px;}
    .advanced-access summary{cursor:pointer;color:#475569;font-size:12px;font-weight:600;list-style:none;display:flex;align-items:center;justify-content:space-between;padding:4px 0 10px;}
    .advanced-access summary::after{content:'+';font-size:16px;font-weight:400;color:#94a3b8;}
    .advanced-access[open] summary::after{content:'−';}
    .profile-badge{display:inline-block;background:#eef2f6;color:#334155;border:1px solid #d7dde5;border-radius:5px;padding:3px 8px;font-size:11px;font-weight:700;}
    .access-summary{font-size:11px;color:#64748b;margin-top:4px;line-height:1.35;}

    /* PERMISSION TOGGLES */
    .perm-section{background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:14px;margin-bottom:14px;}
    .perm-section-title{font-size:11px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.05em;margin-bottom:10px;}
    .perm-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
    .perm-toggle{display:flex;align-items:center;justify-content:space-between;padding:8px 10px;background:#fff;border:1px solid #e2e8f0;border-radius:8px;cursor:pointer;transition:all .12s;user-select:none;}
    .perm-toggle:hover{border-color:#93c5fd;background:#f0f9ff;}
    .perm-toggle.on{border-color:#86efac;background:#f0fdf4;}
    .perm-toggle.on-del{border-color:#fca5a5;background:#fef2f2;}
    .perm-toggle.on-adm{border-color:#c4b5fd;background:#faf5ff;}
    .perm-toggle.on-log{border-color:#67e8f9;background:#f0fdff;}
    .perm-toggle.on-aud{border-color:#fcd34d;background:#fffbeb;}
    .perm-toggle.on-ven{border-color:#93c5fd;background:#eff6ff;}
    .perm-toggle.on-tgs{border-color:#fb923c;background:#fff7ed;}
    .perm-toggle.on-vmtc{border-color:#7dd3fc;background:#f0f9ff;}
    .perm-toggle.on-tmtc{border-color:#d8b4fe;background:#fdf4ff;}
    .perm-name{font-size:12px;font-weight:600;color:#374151;}
    .perm-toggle.on .perm-name,.perm-toggle.on-log .perm-name,.perm-toggle.on-adm .perm-name{color:#16a34a;}
    .perm-toggle.on-del .perm-name{color:#dc2626;}
    .perm-toggle.on-adm .perm-name{color:#7c3aed;}
    .perm-toggle.on-log .perm-name{color:#0891b2;}
    .perm-toggle.on-aud .perm-name{color:#d97706;}
    .perm-toggle.on-ven .perm-name{color:#2563eb;}
    .perm-toggle.on-tgs .perm-name{color:#ea580c;}
    .perm-toggle.on-vmtc .perm-name{color:#0284c7;}
    .perm-toggle.on-tmtc .perm-name{color:#9333ea;}
    .switch{width:32px;height:18px;background:#e2e8f0;border-radius:9px;position:relative;transition:background .2s;flex-shrink:0;}
    .switch::after{content:'';position:absolute;top:3px;left:3px;width:12px;height:12px;border-radius:50%;background:#fff;transition:transform .2s;box-shadow:0 1px 3px rgba(0,0,0,.2);}
    .perm-toggle.on .switch,.perm-toggle.on-log .switch{background:#16a34a;}
    .perm-toggle.on-del .switch{background:#dc2626;}
    .perm-toggle.on-adm .switch{background:#7c3aed;}
    .perm-toggle.on-log .switch{background:#0891b2;}
    .perm-toggle.on-aud .switch{background:#d97706;}
    .perm-toggle.on-ven .switch{background:#2563eb;}
    .perm-toggle.on-tgs .switch{background:#ea580c;}
    .perm-toggle.on-vmtc .switch{background:#0284c7;}
    .perm-toggle.on-tmtc .switch{background:#9333ea;}
    .perm-toggle.on .switch::after,.perm-toggle.on-del .switch::after,.perm-toggle.on-adm .switch::after,.perm-toggle.on-log .switch::after,.perm-toggle.on-aud .switch::after,.perm-toggle.on-ven .switch::after,.perm-toggle.on-tgs .switch::after,.perm-toggle.on-vmtc .switch::after,.perm-toggle.on-tmtc .switch::after{transform:translateX(14px);}
    .btn-add{width:100%;padding:10px;background:#16a34a;color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;margin-top:4px;}
    .btn-add:hover{background:#15803d;}

    /* TABLE PANEL */
    .table-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;overflow:hidden;}
    .table-card-head{padding:16px 20px;border-bottom:1px solid #f1f5f9;display:flex;align-items:center;justify-content:space-between;}
    .table-card-title{font-size:13px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.04em;}
    .count-badge{background:#f1f5f9;color:#475569;border-radius:20px;padding:2px 10px;font-size:12px;font-weight:600;}
    .user-table{width:100%;border-collapse:collapse;}
    .user-table thead th{padding:10px 16px;font-size:11px;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.05em;background:#f8fafc;border-bottom:1px solid #e2e8f0;white-space:nowrap;}
    .user-table tbody td{padding:12px 16px;font-size:13px;color:#0f172a;border-bottom:1px solid #f1f5f9;vertical-align:middle;}
    .user-table tbody tr:last-child td{border-bottom:none;}
    .user-table tbody tr:hover td{background:#fafafa;}
    .avatar{width:32px;height:32px;border-radius:50%;background:#dbeafe;display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;color:#1d4ed8;flex-shrink:0;}
    .you-tag{display:inline-block;background:#f0fdf4;color:#16a34a;border:1px solid #86efac;border-radius:4px;padding:1px 6px;font-size:10px;font-weight:700;margin-left:6px;}
    .role-tag{display:inline-block;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:700;}
    .rt-admin{background:#faf5ff;color:#7c3aed;}
    .rt-user{background:#f0fdf4;color:#16a34a;}
    .rt-viewer{background:#f0f9ff;color:#0284c7;}
    .rt-other{background:#f8fafc;color:#64748b;}
    .div-tag{display:inline-block;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:600;background:#f1f5f9;color:#475569;}
    .pt-wrap{display:flex;flex-wrap:wrap;gap:3px;}
    .pt{display:inline-block;padding:1px 6px;border-radius:3px;font-size:10px;font-weight:700;}
    .pt-v{background:#dbeafe;color:#1d4ed8;} .pt-a{background:#dcfce7;color:#16a34a;} .pt-e{background:#d1fae5;color:#059669;}
    .pt-d{background:#fee2e2;color:#dc2626;} .pt-as{background:#fef9c3;color:#ca8a04;} .pt-ex{background:#ede9fe;color:#7c3aed;}
    .pt-u{background:#e0e7ff;color:#4338ca;} .pt-l{background:#cffafe;color:#0891b2;} .pt-au{background:#fef3c7;color:#d97706;}
    .pt-vn{background:#dbeafe;color:#2563eb;} .pt-tg{background:#ffedd5;color:#ea580c;} .pt-vm{background:#e0f2fe;color:#0284c7;} .pt-tmtc{background:#faf5ff;color:#9333ea;}
    .btn-edit-sm{padding:4px 10px;background:#eff6ff;color:#2563eb;border:1px solid #93c5fd;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;}
    .btn-edit-sm:hover{background:#2563eb;color:#fff;}
    .btn-del-sm{padding:4px 10px;background:#fef2f2;color:#dc2626;border:1px solid #fca5a5;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;}
    .btn-del-sm:hover{background:#dc2626;color:#fff;}
    @media(max-width:768px){.page{padding:16px 12px;} .perm-grid{grid-template-columns:1fr;}}
  </style>
</head>
<body>
<%- include('navbar', {activePage: 'users'}) %>
<div class="page">
  <% if (typeof msg !== 'undefined' && msg) { %>
  <div class="<%= msgType==='error'?'alert-err':'alert-ok' %>"><%= msg %></div>
  <% } %>

  <div class="row g-4">
    <!-- FORM PANEL -->
    <div class="col-md-4">
      <div class="form-card">
        <div class="form-card-title">Tambah User Baru</div>
        <form action="/users/tambah" method="POST" id="formTambah">

          <label class="f-label">Nama Lengkap</label>
          <input type="text" name="nama" class="f-input" placeholder="Nama lengkap" required>

          <label class="f-label">Username</label>
          <input type="text" name="username" class="f-input" placeholder="huruf kecil tanpa spasi" required pattern="[a-z0-9_]+">

          <label class="f-label">Password</label>
          <input type="password" name="password" id="newPass" class="f-input" placeholder="Min 6 karakter" required minlength="6" oninput="checkStrength(this.value,'passStrengthBar')">
          <div class="pass-bar"><div class="pass-fill" id="passStrengthBar"></div></div>

          <label class="f-label">No. HP / WhatsApp <span style="color:#94a3b8;font-weight:400;">(untuk notif WA)</span></label>
          <input type="text" name="noHp" id="add_noHp" class="f-input" placeholder="628xxx...">

          <label class="f-label">Profil Akses</label>
          <select id="add_profile" class="f-input" onchange="setProfile('add',this.value)">
            <option value="reporter">Pelapor Maintenance</option>
            <option value="maintenance">Teknisi Maintenance</option>
            <option value="admin">Administrator</option>
            <option value="audit">Audit</option>
          </select>
          <div class="profile-help" id="add_profileHelp">Melihat semua laporan, membuat laporan, dan mengedit laporan miliknya sendiri.</div>
          <input type="hidden" name="role" id="add_role" value="pelapor">

          <label class="f-label">Divisi</label>
          <select name="divisi" id="add_divisi" class="f-input">
            <option value="IT">IT</option>
            <option value="MAINTENANCE">MAINTENANCE</option>
            <option value="HRGA">HRGA</option>
            <option value="ACCOUNTING">ACCOUNTING</option>
            <option value="FINANCE">FINANCE</option>
            <option value="OPERASIONAL">OPERASIONAL</option>
            <option value="PRODUKSI">PRODUKSI</option>
            <option value="BAHANBAKU">BAHANBAKU</option>
            <option value="ADMIN SALES">ADMIN SALES</option>
            <option value="EXIM & PEMBELIAN">EXIM &amp; PEMBELIAN</option>
            <option value="IT & IC">IT &amp; IC</option>
            <option value="INTERNAL CONTROL">INTERNAL CONTROL</option>
          </select>

          <!-- HIDDEN CHECKBOXES (dikelola JS) -->
          <input type="checkbox" name="canView"            id="add_canView"            style="display:none;">
          <input type="checkbox" name="canAdd"             id="add_canAdd"             style="display:none;">
          <input type="checkbox" name="canEdit"            id="add_canEdit"            style="display:none;">
          <input type="checkbox" name="canDelete"          id="add_canDelete"          style="display:none;">
          <input type="checkbox" name="canAsset"           id="add_canAsset"           style="display:none;">
          <input type="checkbox" name="canExport"          id="add_canExport"          style="display:none;">
          <input type="checkbox" name="canUsers"           id="add_canUsers"           style="display:none;">
          <input type="checkbox" name="canViewLog"         id="add_canViewLog"         style="display:none;">
          <input type="checkbox" name="canAudit"           id="add_canAudit"           style="display:none;">
          <input type="checkbox" name="canVendor"          id="add_canVendor"          style="display:none;">
          <input type="checkbox" name="canTugas"           id="add_canTugas"           style="display:none;">
          <input type="checkbox" name="canViewMaintenance" id="add_canViewMaintenance" style="display:none;">
          <input type="checkbox" name="canTugasMtc"        id="add_canTugasMtc"        style="display:none;">

          <div class="perm-section">
            <div class="perm-section-title">Akses dari profil</div>
            <div class="profile-help" style="margin:0;">Izin utama diatur otomatis. Buka akses tambahan hanya bila diperlukan.</div>
            <details class="advanced-access">
              <summary>Akses tambahan</summary>
              <div class="perm-grid" id="permGrid_add">
              <div class="perm-toggle" id="pt_add_canView"   onclick="togglePerm('add','canView')"><span class="perm-name">Lihat</span><div class="switch"></div></div>
              <div class="perm-toggle" id="pt_add_canAdd"    onclick="togglePerm('add','canAdd')"><span class="perm-name">Tambah</span><div class="switch"></div></div>
              <div class="perm-toggle" id="pt_add_canEdit"   onclick="togglePerm('add','canEdit')"><span class="perm-name">Edit</span><div class="switch"></div></div>
              <div class="perm-toggle" id="pt_add_canDelete" onclick="togglePerm('add','canDelete')"><span class="perm-name">Hapus</span><div class="switch"></div></div>
              <div class="perm-toggle" id="pt_add_canAsset"  onclick="togglePerm('add','canAsset')"><span class="perm-name">Aset</span><div class="switch"></div></div>
              <div class="perm-toggle" id="pt_add_canExport" onclick="togglePerm('add','canExport')"><span class="perm-name">Export</span><div class="switch"></div></div>
              <div class="perm-toggle" id="pt_add_canUsers"  onclick="togglePerm('add','canUsers')"><span class="perm-name">Kelola User</span><div class="switch"></div></div>
              <div class="perm-toggle" id="pt_add_canViewLog" onclick="togglePerm('add','canViewLog')"><span class="perm-name">Lihat Log IT</span><div class="switch"></div></div>
              <div class="perm-toggle" id="pt_add_canAudit"  onclick="togglePerm('add','canAudit')"><span class="perm-name">Audit</span><div class="switch"></div></div>
              <div class="perm-toggle" id="pt_add_canVendor" onclick="togglePerm('add','canVendor')"><span class="perm-name">Vendor</span><div class="switch"></div></div>
              <div class="perm-toggle" id="pt_add_canTugas"  onclick="togglePerm('add','canTugas')"><span class="perm-name">Kelola Tugas MTC</span><div class="switch"></div></div>
              <div class="perm-toggle" id="pt_add_canViewMaintenance" onclick="togglePerm('add','canViewMaintenance')"><span class="perm-name">Lihat Jurnal MTC</span><div class="switch"></div></div>
              <div class="perm-toggle" id="pt_add_canTugasMtc" onclick="togglePerm('add','canTugasMtc')"><span class="perm-name">Tugas MTC</span><div class="switch"></div></div>
              </div>
            </details>
          </div>

          <button type="submit" class="btn-add">Simpan User</button>
        </form>
      </div>
    </div>

    <!-- TABLE PANEL -->
    <div class="col-md-8">
      <div class="table-card">
        <div class="table-card-head">
          <span class="table-card-title">Daftar User</span>
          <span class="count-badge"><%= users.length %> akun</span>
        </div>
        <div style="overflow-x:auto;">
          <table class="user-table">
            <thead><tr><th>#</th><th>User</th><th>Divisi</th><th>Profil Akses</th><th>Dibuat</th><th>Aksi</th></tr></thead>
            <tbody>
              <% users.forEach((u,i) => {
                let perms = {};
                try { perms = u.permissions ? JSON.parse(u.permissions) : {}; } catch(e) {}
                const profileName = perms.canAudit && !perms.canUsers ? 'Audit'
                  : perms.canUsers ? 'Administrator'
                  : (u.role||'').toLowerCase()==='pelapor' ? 'Pelapor Maintenance'
                  : (u.divisi||'').toUpperCase()==='MAINTENANCE' ? 'Teknisi Maintenance'
                  : 'Custom / akun lama';
                const accessNotes = [];
                if (perms.canExport) accessNotes.push('Export Excel');
                if (perms.canAsset) accessNotes.push('Aset');
                if (perms.canVendor) accessNotes.push('Vendor');
                const initials = u.nama ? u.nama.split(' ').slice(0,2).map(w=>w[0]).join('').toUpperCase() : u.username.slice(0,2).toUpperCase();
              %>
              <tr>
                <td style="color:#94a3b8;font-size:12px;"><%= i+1 %></td>
                <td>
                  <div style="display:flex;align-items:center;gap:10px;">
                    <div class="avatar"><% if(u.fotoUrl){%><img src="<%= u.fotoUrl %>" style="width:100%;height:100%;object-fit:cover;border-radius:50%;"><%}else{%><%= initials %><%}%></div>
                    <div>
                      <div style="font-weight:600;"><%= u.nama %><% if(currentUser&&u.id===currentUser.id){%><span class="you-tag">Kamu</span><%}%></div>
                      <div style="font-size:12px;color:#64748b;">@<%= u.username %></div>
                    </div>
                  </div>
                </td>
                <td><span class="div-tag"><%= u.divisi||'IT' %></span></td>
                <td>
                  <span class="profile-badge"><%= profileName %></span>
                  <% if (accessNotes.length) { %><div class="access-summary">Tambahan: <%= accessNotes.join(', ') %></div><% } %>
                </td>
                <td style="font-size:12px;color:#64748b;white-space:nowrap;"><%= new Date(u.createdAt).toLocaleDateString('id-ID',{day:'2-digit',month:'short',year:'numeric'}) %></td>
                <td>
                  <div style="display:flex;gap:6px;">
                    <button class="btn-edit-sm" onclick="openEditModal(<%= u.id %>,`<%= u.nama.replace(/`/g,'\\`') %>`,`<%= u.username %>`,`<%= u.role %>`,`<%= u.divisi||'IT' %>`,<%= JSON.stringify(perms) %>,`<%= u.noHp||'' %>`)">Edit</button>
                    <% if(!currentUser||u.id!==currentUser.id){ %>
                    <button class="btn-del-sm" onclick="confirmHapus(<%= u.id %>,`<%= u.nama.replace(/`/g,'\\`') %>`)">Hapus</button>
                    <%}else{%><button class="btn-del-sm" style="opacity:.3;cursor:not-allowed;" disabled>Hapus</button><%}%>
                  </div>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- MODAL EDIT USER -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content" style="border-radius:14px;">
      <div class="modal-header" style="border-bottom:1px solid #f1f5f9;"><h5 class="modal-title" style="font-size:15px;font-weight:700;">Edit User</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <form id="formEdit" action="" method="POST">
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="f-label">Nama Lengkap</label>
              <input type="text" name="nama" id="edit_nama" class="f-input" required>
              <label class="f-label">Username</label>
              <input type="text" name="username" id="edit_username" class="f-input" required pattern="[a-z0-9_]+">
              <label class="f-label">Profil Akses</label>
              <select id="edit_profile" class="f-input" onchange="setProfile('edit',this.value)">
                <option value="reporter">Pelapor Maintenance</option>
                <option value="maintenance">Teknisi Maintenance</option>
                <option value="admin">Administrator</option>
                <option value="audit">Audit</option>
                <option value="custom">Custom / akun lama</option>
              </select>
              <div class="profile-help" id="edit_profileHelp"></div>
              <input type="hidden" name="role" id="edit_role">
              <label class="f-label">Divisi</label>
              <select name="divisi" id="edit_divisi" class="f-input">
                <option value="IT">IT</option><option value="MAINTENANCE">MAINTENANCE</option>
                <option value="HRGA">HRGA</option><option value="ACCOUNTING">ACCOUNTING</option>
                <option value="FINANCE">FINANCE</option><option value="OPERASIONAL">OPERASIONAL</option>
                <option value="PRODUKSI">PRODUKSI</option><option value="BAHANBAKU">BAHANBAKU</option>
                <option value="ADMIN SALES">ADMIN SALES</option>
                <option value="EXIM & PEMBELIAN">EXIM &amp; PEMBELIAN</option>
                <option value="IT & IC">IT &amp; IC</option>
                <option value="INTERNAL CONTROL">INTERNAL CONTROL</option>
              </select>
              <label class="f-label">No. HP / WhatsApp</label>
              <input type="text" name="noHp" id="edit_noHp" class="f-input" placeholder="628xxx...">
              <label class="f-label">Password Baru <span style="color:#94a3b8;font-weight:400;">(kosong = tidak berubah)</span></label>
              <input type="password" name="password" id="edit_pass" class="f-input" placeholder="Min 6 karakter" minlength="6" oninput="checkStrength(this.value,'passStrengthBarEdit')">
              <div class="pass-bar"><div class="pass-fill" id="passStrengthBarEdit"></div></div>
            </div>
            <div class="col-md-6">
              <div class="perm-section" style="height:100%;">
                <div class="perm-section-title">Akses dari profil</div>
                <div class="profile-help" style="margin:0;">Izin utama mengikuti profil. Pengaturan di bawah dapat dipakai untuk kebutuhan khusus.</div>
                <!-- HIDDEN CHECKBOXES EDIT -->
                <input type="checkbox" name="canView"            id="edit_canView"            style="display:none;">
                <input type="checkbox" name="canAdd"             id="edit_canAdd"             style="display:none;">
                <input type="checkbox" name="canEdit"            id="edit_canEdit"            style="display:none;">
                <input type="checkbox" name="canDelete"          id="edit_canDelete"          style="display:none;">
                <input type="checkbox" name="canAsset"           id="edit_canAsset"           style="display:none;">
                <input type="checkbox" name="canExport"          id="edit_canExport"          style="display:none;">
                <input type="checkbox" name="canUsers"           id="edit_canUsers"           style="display:none;">
                <input type="checkbox" name="canViewLog"         id="edit_canViewLog"         style="display:none;">
                <input type="checkbox" name="canAudit"           id="edit_canAudit"           style="display:none;">
                <input type="checkbox" name="canVendor"          id="edit_canVendor"          style="display:none;">
                <input type="checkbox" name="canTugas"           id="edit_canTugas"           style="display:none;">
                <input type="checkbox" name="canViewMaintenance" id="edit_canViewMaintenance" style="display:none;">
                <input type="checkbox" name="canTugasMtc"        id="edit_canTugasMtc"        style="display:none;">
                <details class="advanced-access">
                  <summary>Akses tambahan</summary>
                  <div class="perm-grid" id="permGrid_edit">
                  <div class="perm-toggle" id="pt_edit_canView"             onclick="togglePerm('edit','canView')"><span class="perm-name">Lihat</span><div class="switch"></div></div>
                  <div class="perm-toggle" id="pt_edit_canAdd"              onclick="togglePerm('edit','canAdd')"><span class="perm-name">Tambah</span><div class="switch"></div></div>
                  <div class="perm-toggle" id="pt_edit_canEdit"             onclick="togglePerm('edit','canEdit')"><span class="perm-name">Edit</span><div class="switch"></div></div>
                  <div class="perm-toggle" id="pt_edit_canDelete"           onclick="togglePerm('edit','canDelete')"><span class="perm-name">Hapus</span><div class="switch"></div></div>
                  <div class="perm-toggle" id="pt_edit_canAsset"            onclick="togglePerm('edit','canAsset')"><span class="perm-name">Aset</span><div class="switch"></div></div>
                  <div class="perm-toggle" id="pt_edit_canExport"           onclick="togglePerm('edit','canExport')"><span class="perm-name">Export</span><div class="switch"></div></div>
                  <div class="perm-toggle" id="pt_edit_canUsers"            onclick="togglePerm('edit','canUsers')"><span class="perm-name">Kelola User</span><div class="switch"></div></div>
                  <div class="perm-toggle" id="pt_edit_canViewLog"          onclick="togglePerm('edit','canViewLog')"><span class="perm-name">Lihat Log IT</span><div class="switch"></div></div>
                  <div class="perm-toggle" id="pt_edit_canAudit"            onclick="togglePerm('edit','canAudit')"><span class="perm-name">Audit</span><div class="switch"></div></div>
                  <div class="perm-toggle" id="pt_edit_canVendor"           onclick="togglePerm('edit','canVendor')"><span class="perm-name">Vendor</span><div class="switch"></div></div>
                  <div class="perm-toggle" id="pt_edit_canTugas"            onclick="togglePerm('edit','canTugas')"><span class="perm-name">Kelola Tugas MTC</span><div class="switch"></div></div>
                  <div class="perm-toggle" id="pt_edit_canViewMaintenance"  onclick="togglePerm('edit','canViewMaintenance')"><span class="perm-name">Lihat Jurnal MTC</span><div class="switch"></div></div>
                  <div class="perm-toggle" id="pt_edit_canTugasMtc"         onclick="togglePerm('edit','canTugasMtc')"><span class="perm-name">Tugas MTC</span><div class="switch"></div></div>
                  </div>
                </details>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer" style="border-top:1px solid #f1f5f9;"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button><button type="submit" class="btn btn-primary fw-bold">Simpan</button></div>
      </form>
    </div>
  </div>
</div>

<!-- MODAL HAPUS -->
<div class="modal fade" id="hapusModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius:12px;">
      <div class="modal-header" style="border-bottom:1px solid #f1f5f9;"><h5 class="modal-title" style="font-size:15px;font-weight:700;color:#dc2626;">Hapus User</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body"><p style="margin:0 0 6px;">Hapus akun <span id="hapusNama" style="font-weight:700;color:#dc2626;"></span>?</p><p style="font-size:12px;color:#94a3b8;">Data tidak bisa dikembalikan.</p></div>
      <div class="modal-footer" style="border-top:1px solid #f1f5f9;"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Batal</button>
        <form id="formHapus" action="" method="POST" style="display:inline;"><button type="submit" class="btn btn-danger fw-bold">Hapus</button></form>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function(){ var t=localStorage.getItem('theme')||'dark'; document.documentElement.setAttribute('data-theme',t); })();

var PERM_KEYS = ['canView','canAdd','canEdit','canDelete','canAsset','canExport','canUsers','canViewLog','canAudit','canVendor','canTugas','canViewMaintenance','canTugasMtc'];
var permState = { add:{}, edit:{} };
PERM_KEYS.forEach(function(k){ permState.add[k]=false; permState.edit[k]=false; });

var PRESETS = {
  admin:             {canView:true,canAdd:true,canEdit:true,canDelete:true,canAsset:true,canExport:true,canUsers:true,canViewLog:true,canAudit:false,canVendor:true,canTugas:true,canViewMaintenance:true,canTugasMtc:true},
  maintenance:       {canView:true,canAdd:true,canEdit:true,canDelete:false,canAsset:false,canExport:true,canUsers:false,canViewLog:true,canAudit:false,canVendor:false,canTugas:false,canViewMaintenance:true,canTugasMtc:true},
  reporter:          {canView:false,canAdd:false,canEdit:false,canDelete:false,canAsset:false,canExport:false,canUsers:false,canViewLog:false,canAudit:false,canVendor:false,canTugas:false,canViewMaintenance:false,canTugasMtc:false},
  audit:             {canView:false,canAdd:false,canEdit:false,canDelete:false,canAsset:true,canExport:true,canUsers:false,canViewLog:false,canAudit:true,canVendor:true,canTugas:false,canViewMaintenance:false,canTugasMtc:false},
  clear:             {canView:false,canAdd:false,canEdit:false,canDelete:false,canAsset:false,canExport:false,canUsers:false,canViewLog:false,canAudit:false,canVendor:false,canTugas:false,canViewMaintenance:false,canTugasMtc:false}
};

var PROFILE_HELP = {
  reporter:'Melihat semua laporan, membuat laporan, dan mengedit laporan miliknya sendiri.',
  maintenance:'Menerima laporan, mengerjakan tugas, membuka dashboard maintenance, dan export Excel.',
  admin:'Akses penuh ke seluruh fitur dan pengelolaan user.',
  audit:'Profil audit lama tetap dipertahankan.',
  custom:'Akun lama dengan kombinasi izin khusus.'
};

var ON_CLASS = {canView:'on',canAdd:'on',canEdit:'on',canDelete:'on-del',canAsset:'on',canExport:'on',canUsers:'on-adm',canViewLog:'on-log',canAudit:'on-aud',canVendor:'on-ven',canTugas:'on-tgs',canViewMaintenance:'on-vmtc',canTugasMtc:'on-tmtc'};

function renderPerms(form) {
  PERM_KEYS.forEach(function(k){
    var el = document.getElementById('pt_'+form+'_'+k);
    var cb = document.getElementById((form==='add'?'add':'edit')+'_'+k);
    if(!el||!cb) return;
    var val = permState[form][k];
    el.className = 'perm-toggle' + (val ? ' '+ON_CLASS[k] : '');
    cb.checked = val;
  });
}

function togglePerm(form,perm){ permState[form][perm]=!permState[form][perm]; renderPerms(form); }

function setPreset(form,preset){
  permState[form] = Object.assign({},PRESETS[preset]);
  if(preset==='maintenance'){ var d=document.getElementById(form==='add'?'add_divisi':'edit_divisi'); if(d)d.value='MAINTENANCE'; }
  else if(preset==='viewerMaintenance'){ var d=document.getElementById(form==='add'?'add_divisi':'edit_divisi'); if(d)d.value='HRGA'; }
  else if(preset==='user'||preset==='admin'){ var d=document.getElementById(form==='add'?'add_divisi':'edit_divisi'); if(d&&(d.value==='MAINTENANCE'||d.value==='HRGA'))d.value='IT'; }
  renderPerms(form);
}

function setProfile(form,profile){
  if(profile==='custom') return;
  permState[form] = Object.assign({},PRESETS[profile]);
  var prefix=form==='add'?'add':'edit';
  var role=document.getElementById(prefix+'_role');
  var divisi=document.getElementById(prefix+'_divisi');
  var help=document.getElementById(prefix+'_profileHelp');
  if(role) role.value=profile==='reporter'?'pelapor':profile;
  if(divisi && profile==='maintenance') divisi.value='MAINTENANCE';
  if(divisi && profile==='admin') divisi.value='IT';
  if(divisi && profile==='audit') divisi.value='INTERNAL CONTROL';
  if(help) help.textContent=PROFILE_HELP[profile]||'';
  renderPerms(form);
}

function detectProfile(role,divisi,perms){
  if(perms.canAudit && !perms.canUsers) return 'audit';
  if(perms.canUsers) return 'admin';
  if((role||'').toLowerCase()==='pelapor') return 'reporter';
  if((divisi||'').toUpperCase()==='MAINTENANCE') return 'maintenance';
  return 'custom';
}

function openEditModal(id,nama,username,role,divisi,perms,noHp){
  document.getElementById('formEdit').action='/users/edit/'+id;
  document.getElementById('edit_nama').value=nama;
  document.getElementById('edit_username').value=username;
  document.getElementById('edit_role').value=role;
  document.getElementById('edit_divisi').value=divisi||'IT';
  document.getElementById('edit_noHp').value=noHp||'';
  document.getElementById('edit_pass').value='';
  document.getElementById('passStrengthBarEdit').style.width='0%';
  permState.edit = Object.assign({},PRESETS.clear,perms||{});
  var profile=detectProfile(role,divisi,permState.edit);
  document.getElementById('edit_profile').value=profile;
  document.getElementById('edit_profileHelp').textContent=PROFILE_HELP[profile]||'';
  renderPerms('edit');
  new bootstrap.Modal(document.getElementById('editModal')).show();
}

function confirmHapus(id,nama){
  document.getElementById('formHapus').action='/users/hapus/'+id;
  document.getElementById('hapusNama').textContent='"'+nama+'"';
  new bootstrap.Modal(document.getElementById('hapusModal')).show();
}

function checkStrength(v,barId){
  var s=0,w=''; if(v.length>=6)s++;if(v.length>=10)s++;if(/[A-Z]/.test(v))s++;if(/[0-9]/.test(v))s++;if(/[^A-Za-z0-9]/.test(v))s++;
  var c=['#e2e8f0','#ef4444','#f97316','#eab308','#22c55e','#16a34a'][s];
  var bar=document.getElementById(barId);if(bar){bar.style.width=(s*20)+'%';bar.style.background=c;}
}

function toggleTheme(){var c=document.documentElement.getAttribute('data-theme');var n=c==='dark'?'light':'dark';document.documentElement.setAttribute('data-theme',n);localStorage.setItem('theme',n);updateThemeUI(n);}
function updateThemeUI(t){var l=document.getElementById('navThemeLabel');var th=document.getElementById('navThumb');if(l)l.textContent=t==='light'?'Light':'Dark';document.documentElement.setAttribute('data-theme',t);if(th){th.style.transform=t==='light'?'translateX(12px)':'';th.style.background=t==='light'?'#fff':'';}};
(function(){updateThemeUI(localStorage.getItem('theme')||'dark');})();
function toggleUserDropdown(e){e.stopPropagation();document.getElementById('userDropdown')?.classList.toggle('open');}
document.addEventListener('click',function(){document.getElementById('userDropdown')?.classList.remove('open');});
function toggleMobileNav(){document.getElementById('mobileNav')?.classList.add('open');document.getElementById('sidebarOverlay')?.classList.add('open');}
function closeSidebar(){document.getElementById('mobileNav')?.classList.remove('open');document.getElementById('sidebarOverlay')?.classList.remove('open');}
setProfile('add','reporter');
</script>
</body>
</html>
